  key             String   @id
  value           Json
  updatedByUserId String
  updatedBy       User     @relation(fields: [updatedByUserId], references: [id])
  updatedAt       DateTime @updatedAt
}

model Idea {
  id                        String          @id @default(uuid())
  creatorId                 String
  creator                   User            @relation("IdeaCreator", fields: [creatorId], references: [id])
  /// ⚠ 25-P §1.9 — HOW MANY ROUNDS OF "COMMENT AND RE-RUN" THE USER HAS BEEN THROUGH ON THE
  /// GUIDING POLICY. After two, Lex offers to proceed with the choice recorded as unresolved
  /// rather than asking a third time: three rounds of the same question reads as nagging, and
  /// "unresolved, and here is what it turns on" is a respectable thing for a proposal to say.
  guidingPolicyRounds       Int             @default(0)
  /// §1.9/§1.10 — the user chose to proceed without settling. Not a failure state.
  guidingPolicyUnresolved   Boolean         @default(false)
  /// ⚠ WHAT IT TURNS ON. An unresolved choice with no reason tells a reader there is a gap and
  /// nothing whatever about it.
  guidingPolicyUnresolvedWhy String?

  /// ══ 25-O §4b — ARCHIVED, WHICH IS NOT DELETED AND NOT SOFT-DELETED ═══════════════
  ///
  /// §4b: *"Archive, never hard-delete. Mark archived; hide from every list, every count and
  /// every search; keep the rows."* Three testers made ideas under the previous structure;
  /// they were going wrong at the time, Charlie is explaining to those three directly, and the
  /// ideas should not appear anywhere in the product.
  ///
  /// ⚠⚠ IT IS A SEPARATE COLUMN FROM `deletedAt`, AND THAT IS THE WHOLE DESIGN. `deletedAt`
  /// means the OWNER deleted it — it is their act, it is undoable by them, and 25-H already
  /// learned what happens when a deletion is claimed and not made (three copies reported
  /// deleted were still in the database five days later, two wearing real titles). This is an
  /// ADMIN act on somebody else's work: reusing `deletedAt` would make the two indistinguishable
  /// afterwards, so nobody could tell whether a user had deleted their own idea or we had hidden
  /// it from them — and the second is the one you have to be able to answer for.
  ///
  /// ⚠ THE ROWS ARE KEPT. Every build, every finding, every note survives; only the visibility
  /// changes, so a mistake is one UPDATE away from being undone and nothing has been lost while
  /// it stood.
  archivedAt                DateTime?
  /// Who archived it and why. An archive with no record of who made it is the unaccountable
  /// act `buildAllowanceNote` exists to prevent, one table over.
  archivedReason            String?
  /// 25-N §3c — the working notes, private to whoever wrote them.
  notesPrivate              IdeaNote[]
  fieldRevisions            FieldRevision[]
  /// 25-N §3e — which worklist items each user has ticked off.
  worklistTicks             IdeaWorklistTick[]
  // Basic info
  title                     String
  summaryDescription        String
  summaryDiagnosis          String?
  summaryGuidingPolicy      String?
  summaryCoherentActions    String?
  backgroundResearch        String?
  initialThoughts           Json?
  ideaType                  IdeaType        @default(LEGISLATION)
  govtArea                  String
  govtLevel                 GovtLevel       @default(NATIONAL)
  country                   String?         @default("GB")
  connectedIdeaIds          Json?
  // Strategic kernel
  diagnosis                 String?
  guidingPolicy             String?
  rootCause                 String?
  whoAffected               String?
  // Classification
  stage                     IdeaStage       @default(STAGE_1)
  visibility                IdeaVisibility  @default(PRIVATE)
  status                    IdeaStatus      @default(DRAFT)
  sector                    String?
  // Wording
  proposedWording           String?
  wordingLocked             Boolean         @default(false)
  version                   Int             @default(1)
  // Metrics (denormalised)
  voteCount                 Int             @default(0)
  passionScore              Decimal?
  voteDistribution          Json?
  commentCount              Int             @default(0)
  amendmentCount            Int             @default(0)
  endorsementCount          Int             @default(0)
  draftsmanEndorsementCount Int             @default(0)
  viewCount                 Int             @default(0)
  // Stage eligibility
  eligibleForNextStage      Boolean         @default(false)
  stageEligibleSince        DateTime?
  // Maturity (Sprint 1)
  maturityIndex             Decimal         @default(0)
  maturityIndexDetail       Json?
  maturityLastUpdated       DateTime?
  credibilityWeightedRating Decimal?
  // AI
  aiProvider                AIProvider      @default(GEMINI_FLASH)
  aiChatHistory             Json            @default("[]")
  aiChatSummary             String?
  aiCurrentField            String?
  aiSessionCount            Int             @default(0)
  // Origin / banner
  ideaOrigin                IdeaOrigin      @default(USER)
  bannerColour              String?         // Hex colour for banner; null = no banner shown
  bannerText                String?         // Override banner text; null = use default for origin
  // User profiling (V2K-D1)
  userAdditionalNotes       String?         // Lex-synthesised notes about user background, expertise, motivations
  // Lex rebuild — Page 1 (Orientation): 3 input boxes + generated outputs (see docs/LEX_REBUILD_DESIGN.md §6)
  ideaNarrative             String?         // Box 1 "The idea" raw free text
  youAndIdeaNarrative       String?         // Box 2 "You + The Idea" raw free text
  ideaSlots                 Json?           // { problemNarrative, currentFraming, motivation, priorWork, ideaGoal }
  keywords                  String[]        @default([])  // accepted search keywords (government area inferred among them)
  ideaContext               String?         // §9 migration sink — removed-field content, tagged [migrated: <field>]
  legislationRefs           Json?           // SearchResult[] stub, populated by the search trigger on keywords accept
  // Sprint 3-C (§19-C Task 2) — stage-aware search record + ad-hoc research results.
  // REFERENCES ONLY (id/citation/url/snippet); no corpus full text is copied here.
  // { version, byStage: { <PAGE>: { intent, ranAt, ok, failureReason?, query[], results[] } }, research: [...] }
  stageSearches             Json?
  // §6d Web + X orientation — the Tier B/C background pass that runs alongside the
  // Page-1 corpus search. REFERENCES AND EXTRACTS ONLY: dated, attributed items with
  // their source URL, plus the per-call outcome/latency/cost record. Never a source
  // of legal claims (Tier A is the corpus); Tier C is quarantined per §6d.3.
  // { ranAt, recencyDays, recency{…}, comparative[], argumentsMined[], calls[], failed, … }
  orientation               Json?
  // Lex rebuild — the current Lex PAGE the user has advanced into (§14 / Sprint 2).
  // Distinct from the 5-stage lifecycle `stage`. Advanced explicitly ("Continue to Diagnosis").
  lexPage                   String?         @default("ORIENTATION") // ORIENTATION | DIAGNOSIS | …
  // Lex rebuild — Page 2 (Diagnosis) fields (design §7.1). challenge/pivotalObstacle text;
  // whoAffectedImpactCost/legalLandscape are structured slot objects. rootCause +
  // summaryDiagnosis reuse the existing legacy Idea columns above.
  challenge                 String?         // one-sentence problem statement
  whoAffectedImpactCost     Json?           // { affectedGroups[], impact, cost, evidence }
  legalLandscape            Json?           // { currentLaw, whereItFails }
  pivotalObstacle           String?         // the critical thing blocking a solution (Rumelt)
  // Lex rebuild — Page 3 (Guiding Policy) fields (design §17). summaryGuidingPolicy reuses legacy col above.
  chosenApproach            String?         // the committed approach (mirrors the CHOSEN PolicyOption)
  whatItRulesOut            String?         // composed from the RULED_OUT options + their reasons
  leverage                  String?         // why this approach hits the pivotal obstacle specifically
  anticipatedResponses      Json?           // { avoidance, gaming, enforcementBurden, legalChallenge, politicalAttack }
  conditionsForSuccessLex   String?         // testable bets ("for this to work, X must be true")
  // Lex rebuild — Page 4 (Coherent Actions) aggregates (design §18). summaryCoherentActions reuses legacy col.
  coherenceCheck            String?         // Lex commentary: mutual consistency, concentration, sequencing
  costSummary               Json?           // aggregated totals set against the Page 2 problem cost
  // Referral
  referralLinkActive        Boolean         @default(false)
  // Ownership transfer
  ownershipTransferToken    String?         @unique
  ownershipTransferToId     String?
  ownershipTransferExpiry   DateTime?
  // Community origin — informational/display only ("this Idea originated in this
  // Community"). Community membership intentionally grants no Idea access — Idea
  // permissions stay governed entirely by IdeaCollaborator/Group, unchanged.
  // Decision 22 Jul 2026.
  communityId               String?
  community                 Community?      @relation(fields: [communityId], references: [id])
  // Sprint 20-D (§20.3) — PROPOSAL publication. Deliberately NOT the `visibility`
  // column above: that one is the five-stage lifecycle's visibility, read by the
  // stage gates and every listing query, and an idea can be STAGE_3 link-only
  // while its proposal is unpublished. See prisma/lex_proposal_20bd.sql.
  proposalVisibility         ProposalVisibility @default(PRIVATE)
  /// ⚠ THE PIN. Every share resolver reads this and never "the latest version" —
  /// that is the whole of "a recipient's link does not shift under them while the
  /// owner keeps editing" (§20.3).
  publishedProposalVersionId String?
  publishedProposalVersion   ProposalVersion?   @relation("IdeaPublishedVersion", fields: [publishedProposalVersionId], references: [id], onDelete: SetNull)
  proposalPublishedAt        DateTime?
  /// Minted once and KEPT across re-publishes, so a link already in an MP's inbox
  /// keeps working when the owner publishes a revision. Revoking is
  /// `proposalVisibility = PRIVATE`, which the resolver refuses on.
  proposalShareToken         String?            @unique
  proposalVersions           ProposalVersion[]  @relation("IdeaProposalVersions")
  // Timestamps
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  publishedAt               DateTime?
  withdrawnAt               DateTime?
  /// §19-E Task 6 — the owner deleted this idea. SOFT, so an accidental delete is one
  /// UPDATE away from being undone; a cascade across twenty related tables is not
  /// reversible at all. Deliberately NOT `status = ARCHIVED/WITHDRAWN`: those already
  /// mean something else (a housekeeping state, and a Stage 4/5 public act), and
  /// overloading one would make every later query about archived or withdrawn ideas
  /// silently include deleted ones.
  deletedAt                 DateTime?

  // Relations
  votes                     Vote[]
  comments                  Comment[]
  amendments                Amendment[]
  endorsements              Endorsement[]
  draftsmanEndorsements     DraftsmanEndorsement[]
  research                  Research[]
  attachments               Attachment[]
  collaborators             IdeaCollaborator[]
  stageTransitions          StageTransition[]
  wordingHistory            WordingHistory[]
  coherentActions           CoherentAction[]
  diagnoses                 Diagnosis[]
  rootCauses                RootCause[]
  guidingPolicies           GuidingPolicy[]
  evidence                  Evidence[]
  resourcesCommitted        ResourcesCommitted[]
  targetOrganisations       TargetOrganisation[]
  pointsLedger              PointsLedger[]
  ideaReviews               IdeaReview[]
  ideaAlerts                IdeaAlert[]
  groups                    Group[]
  stageTransitionRequests   StageTransitionRequest[]
  generatedOutputs          GeneratedOutput[]
  notifications             Notification[]
  activityLogs              ActivityLog[]
  aiUsageLogs               AIUsageLog[]
  disputedLogicFlags        DisputedLogicFlag[]
  contentReports            ContentReport[]     @relation("ReportedIdea")
  legislationLinks          IdeaLegislation[]
  fieldStates               IdeaFieldState[]
  documents                 Document[]
  diagnosisCauses           DiagnosisCause[]
  policyOptions             PolicyOption[]
  lexActions                LexCoherentAction[]
  ideaAssumptions           IdeaAssumption[]
  feedbackItems             FeedbackItem[]
  // The Deepening (§22). A SEPARATE EVIDENCE LAYER: these reference canonical fields,
  // they never carry a field's value. See prisma/lex_deepening.sql for why.
  deepeningPasses           DeepeningPass[]
  evidenceItems             EvidenceItem[]
  deepeningIssues           DeepeningIssue[]
  // Sprint 25-A (§25 — the user decides, Lex writes). An ADDED path: nothing above
  // this line changed, so an idea built the current way is unaffected.
  elicitation               IdeaElicitation?
  builds                    IdeaBuild[]
  buildForks                BuildFork[]
  // Sprint 25-D. Two more per-idea records, both additive: what the user decided about
  // each corpus source (§2a), and the user's own documents and links (§25.6).
  sourceDecisions           IdeaSourceDecision[]
  userMaterial              IdeaUserMaterial[]
  // Sprint 25-L. What we refused to read (§2), and the graph claims judged against
  // this idea (§5). Both additive; neither is written by any existing path.
  materialRejections        IdeaMaterialRejection[]
  graphJudgements           GraphClaimJudgement[]
  graphDonationJudgements   GraphDonationJudgement[]

  @@index([creatorId])
  @@index([stage])
  @@index([visibility])
  @@index([status])
  @@index([communityId])
  @@index([proposalVisibility])
}

