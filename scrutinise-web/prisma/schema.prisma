// Scrutinise — Prisma Schema
// Stack: Next.js 14 · TypeScript · Prisma 7 · PostgreSQL (Railway EU West Amsterdam)
// Read entity_list_v4.md before modifying this file.
// Sprint 1 schema changes applied per CC_Sprint1_Briefing.md Section 5.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  CITIZEN
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETION_PENDING
  DELETED
}

enum ParliamentaryStatus {
  MP
  PEER
  NONE
}

enum IdeaStage {
  STAGE_1
  STAGE_2
  STAGE_3
  STAGE_4
  STAGE_5
  ARCHIVED
  WITHDRAWN
}

enum IdeaVisibility {
  PRIVATE
  LINK_ONLY
  PLATFORM_LISTED
}

enum IdeaStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  MERGED
  WITHDRAWN
}

enum IdeaType {
  LEGISLATION
  ORGANISATION
}

enum GovtLevel {
  LOCAL
  DEVOLVED
  NATIONAL
  INTERNATIONAL
}

enum AIProvider {
  GEMINI_FLASH
  GROK_FAST
  USER_CLAUDE
  USER_GPT4O
  USER_GROK
}

enum VoteDirection {
  FOR
  AGAINST
  UNDECIDED
}

enum CommentStance {
  SUPPORTIVE
  CRITICAL
  NEUTRAL
  QUESTION
}

enum ContributionType {
  NEW_INFORMATION
  RED_TEAM_CHALLENGE
  MINOR_ADJUSTMENT
  ADDITIONAL_COHERENT_ACTION
  AMENDMENT
  OTHER
}

enum AmendmentStatus {
  PENDING
  REVISION_REQUESTED
  CONSULTING
  ACCEPTED
  REJECTED
}

enum AmendmentMode {
  MODE_A
  MODE_B
}

enum GroupType {
  MY_TEAM
  COMMUNICATIONS
  POLICY_DEVELOPMENT
}

enum GroupMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum CollaboratorRole {
  EDITOR
  VIEWER
}

enum EndorsementStatus {
  ACTIVE
  WITHDRAWN
}

enum EndorserRole {
  MP
  PEER
}

enum NotificationType {
  VOTE_RECEIVED
  STAGE_ELIGIBLE
  COMMENT_POSTED
  AMENDMENT_PROPOSED
  AMENDMENT_ACCEPTED
  AMENDMENT_REJECTED
  ENDORSEMENT_GIVEN
  COLLABORATOR_INVITED
  COLLABORATOR_ACCEPTED
  MERGE_PROPOSED
  MESSAGE_RECEIVED
  SYSTEM
}

enum ActivityAccessType {
  OWNER
  COLLABORATOR
  LEX_AI
  SYSTEM
  ADMIN_ACCESS
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum ResearchType {
  EVIDENCE
  CASE_STUDY
  CAUSES
  PERSPECTIVES
  OTHER
}

enum SourceType {
  ACADEMIC
  GOVERNMENT
  NEWS
  CASE_STUDY
  LEGISLATION
  OTHER
}

enum IdeaReviewOutcome {
  VIEWED
  ENDORSED
  BELOW_STANDARD
}

enum AlertType {
  VOTE_OPEN
  STAGE_CHANGE
}

enum DraftChangeType {
  DIRECT_EDIT
  AMENDMENT_ACCEPTED
  OWNER_EDIT
}

enum GeneratedOutputType {
  MP_BRIEFING
  ONE_PAGER
  PRESS_RELEASE
  SOCIAL_KIT
}

enum GeneratedOutputStatus {
  PENDING
  COMPLETE
  FAILED
}

enum StageTransitionTrigger {
  AUTOMATIC
  MANUAL_OWNER
  ADMIN_OVERRIDE
}

enum EmailSuppressionReason {
  USER_UNSUBSCRIBED
  ACCOUNT_DELETED
  BOUNCE
  COMPLAINT
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DisputeStatus {
  PENDING
  REVIEWED
}

enum EvidenceOutcome {
  SUCCESS
  FAILURE
  MIXED
}

enum TargetOrganisationType {
  GOVERNMENT_DEPARTMENT
  ARMS_LENGTH_BODY
  LOCAL_AUTHORITY
  DEVOLVED_GOVERNMENT
  NHS_BODY
  REGULATOR
  POLICE_FORCE
  COURT_OR_TRIBUNAL
  PRIVATE_SECTOR
  THIRD_SECTOR
  EDUCATION_INSTITUTION
  INTERNATIONAL_BODY
  OTHER
}

enum PointsCategory {
  STRATEGIST
  THINKER
  RALLYMASTER
  RAINMAKER
  TEAMBUILDER
}

enum PointsReason {
  IDEA_STARTED
  STAGE_2_ADVANCE
  STAGE_3_ADVANCE
  STAGE_4_ADVANCE
  STAGE_5_ADVANCE
  DIAGNOSIS_COMPLETE
  GUIDING_POLICY_COMPLETE
  FIRST_COHERENT_ACTION
  RESEARCH_ADDED
  CONTRIBUTION_SUBMITTED
  CONTRIBUTION_RATED_3
  CONTRIBUTION_RATED_4
  CONTRIBUTION_RATED_5
  CONTRIBUTION_RATED_1_2
  IDEA_RATED
  IDEA_VOTED
  AMENDMENT_ACCEPTED
  REFERRAL_JOIN
  REFERRAL_QUALIFIED
  TEAMBUILDER_CASCADE
  MERGE_COMPLETED
  RED_TEAM_BONUS
}

enum ContentReportReason {
  SPAM
  HARMFUL
  OFF_TOPIC
  MISINFORMATION
  ABUSIVE
  OTHER
}

enum ContentReportStatus {
  PENDING
  UNDER_REVIEW
  DISMISSED
  ACTION_TAKEN
}

enum ExperienceLevelEnum {
  NO_BACKGROUND
  SECTOR_LIVED
  THINK_TANK_JUNIOR
  THINK_TANK_SENIOR
  POLITICAL_JUNIOR
  POLITICAL_SENIOR
  PARLIAMENTARIAN
}

enum IdeaOrigin {
  USER               // Normal user-created idea
  HISTORICAL_EXAMPLE // Enacted legislation case study
  EDITORIAL_SEED     // Platform-seeded policy debate
}

enum LexInsightStatus {
  DRAFT       // Lex has flagged this — pending admin review
  APPROVED    // Admin has approved — approvedRule is added to Lex's context
  REJECTED    // Admin has rejected — stored for reference but not used
}

enum MechanismType {
  INCENTIVES
  RULES
  TRANSPARENCY
  MARKET_DESIGN
  INSTITUTIONAL_RESTRUCTURING
}

enum LegislationTier {
  TIER_1  // Post-2010 Public General Acts — first priority
  TIER_2  // Pre-2010 Public General Acts, Devolved Acts
  TIER_3  // Statutory Instruments
  TIER_4  // Extended corpus (FCA, HMRC, etc.)
}

enum LegislationType {
  UKPGA   // UK Public General Act
  UKSI    // UK Statutory Instrument
  UKLA    // UK Local Act
  ASP     // Act of the Scottish Parliament
  SSI     // Scottish Statutory Instrument
  ANAW    // Act of the National Assembly for Wales / Senedd
  WSI     // Welsh Statutory Instrument
  NIER    // Northern Ireland legislation (generic / legacy)
  NISR    // Northern Ireland Statutory Rule
  NISI    // Northern Ireland Statutory Instrument (Order in Council)
  NIA     // Act of the Northern Ireland Assembly
  EUR     // Retained EU Regulation
  EUDN    // Retained EU Decision
  EUDR    // Retained EU Directive
  ASC     // Act of the Senedd Cymru
  OTHER
}

enum CompilationConfidence {
  HIGH    // All amendments applied without ambiguity
  MEDIUM  // Minor interpretation required
  LOW     // One or more amendments could not be applied — needs review
}

enum CompilationStatus {
  PENDING       // Not yet compiled
  COMPILING     // In progress
  COMPILED      // Complete
  FAILED        // Compilation failed — see errorLog
  NEEDS_REVIEW  // LOW confidence — queued for human review
  PRINT_ONLY    // No digital XML exists; permanently excluded from compilation
}

enum CorrectionStatus {
  PENDING
  LEX_REVIEW
  ADMIN_REVIEW
  ACCEPTED
  REJECTED
}

enum CorrectionDecision {
  ACCEPT
  REJECT
  UNCERTAIN
}

enum DocumentSourceType {
  STATUTE                  // UKPGA, UKSI, ASP, NIA, ANAW, NISI, NISR, SSI, WSI
  STATUTORY_GUIDANCE       // Documents with statutory force but not statutes (FCA Handbook, PRA Rulebook)
  ADMINISTRATIVE_GUIDANCE  // HMRC manuals, Civil Service Code, departmental policy papers
  EXPLANATORY              // Explanatory Notes, Impact Assessments, HoC Library briefings
  PARLIAMENTARY            // Hansard, Bills in progress, Committee reports
  JUDICIAL                 // BAILII case law
  FINANCIAL_DOCUMENT       // Estimates, Spending Reviews, Departmental Annual Reports, PESA
}

enum OperationalIngestStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────────
// SECTION 1 — CORE
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                        String              @id @default(uuid())
  clerkId                   String              @unique
  // Identity
  firstName                 String
  lastName                  String
  name                      String              // Full name — denormalised
  preferredName             String?             // How would you like Lex to address you? Defaults to firstName
  displayName               String?             // @handle display, defaults to "Boss" until set
  username                  String              @unique
  email                     String              @unique
  emailVerified             Boolean             @default(false)
  bio                       String?
  // Role
  role                      UserRole            @default(CITIZEN)
  // Status
  status                    UserStatus          @default(ACTIVE)
  // Consent (Sprint 1)
  ageConfirmed              Boolean             @default(false)
  tcAgreedAt                DateTime?
  rulesAgreedAt             DateTime?
  tcVersion                 String?
  // Parliamentary / professional
  parliamentaryStatus       ParliamentaryStatus @default(NONE)
  parliamentaryVerified     Boolean             @default(false)
  professionalVerified      Boolean             @default(false)
  expertType                String?
  // Political spectrum (store only — UI deferred)
  politicalSpectrumX        Decimal?
  politicalSpectrumY        Decimal?
  // AI
  aiCreditBalance           Decimal             @default(0)
  aiUsageTotal              Decimal             @default(0)
  aiPreferredStyle          String?             // COLLABORATIVE | SOCRATIC | DIRECT — default COLLABORATIVE
  experienceLevel           ExperienceLevelEnum?
  // Historical / seed accounts
  isHistoricalAccount       Boolean             @default(false)
  // Credibility override (admin only)
  manualCredibilityOverride Decimal?
  // Referral
  referralCode              String              @unique
  referredByUserId          String?
  referredBy                User?               @relation("Referrals", fields: [referredByUserId], references: [id])
  referredUsers             User[]              @relation("Referrals")
  // GDPR / account deletion
  deletionRequestedAt       DateTime?
  deletionScheduledFor      DateTime?
  unsubscribeToken          String              @unique @default(uuid())
  // Meta
  country                   String?             @default("GB")
  joinDate                  DateTime            @default(now())
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  lastActiveAt              DateTime?

  // Relations
  ideas                     Idea[]              @relation("IdeaCreator")
  votes                     Vote[]
  comments                  Comment[]
  commentRatings            CommentRating[]
  endorsements              Endorsement[]
  draftsmanEndorsements     DraftsmanEndorsement[]
  notifications             Notification[]
  activityLogs              ActivityLog[]
  adminActivityLogs         ActivityLog[]       @relation("AdminAccessLogs")
  credibilityScore          CredibilityScore?
  ideaCollaborators         IdeaCollaborator[]
  sentInvites               UserInvite[]        @relation("SentInvites")
  groupMemberships          GroupMember[]
  ownedGroups               Group[]
  partyMemberships          PartyMembership[]
  platformConfigUpdates     PlatformConfig[]
  ideaReviews               IdeaReview[]
  ideaAlerts                IdeaAlert[]
  parliamentaryVerifications UserParliamentaryVerification[]
  professionalVerifications  UserProfessionalVerification[]
  aiUsageLogs               AIUsageLog[]
  attachments               Attachment[]
  wordingHistories          WordingHistory[]
  stageTransitions          StageTransition[]
  contentReports            ContentReport[]     @relation("ReportedBy")
  contentReviewedBy         ContentReport[]     @relation("ReviewedBy")
  disputedLogicFlags        DisputedLogicFlag[]
  researchContributions     Research[]
  authoredAmendments        Amendment[]
  lexInsightReviews         LexInsight[]
  reputation                Reputation?
  pointsLedger              PointsLedger[]
  pointsRelatedTo           PointsLedger[]   @relation("PointsRelatedUser")
  referralsMade             ReferralEvent[]  @relation("ReferrerUser")
  referralsReceived         ReferralEvent[]  @relation("ReferredUser")
  legislationCorrections    LegislationCorrection[]
  feedbacks                 Feedback[]

  @@index([clerkId])
  @@index([email])
  @@index([username])
}

model PartyMembership {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  partyName        String
  membershipNumber String?
  memberSince      DateTime?
  isPrimary        Boolean   @default(false)
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model PlatformConfig {
  key             String   @id
  value           Json
  updatedByUserId String
  updatedBy       User     @relation(fields: [updatedByUserId], references: [id])
  updatedAt       DateTime @updatedAt
}

model Idea {
  id                        String          @id @default(uuid())
  creatorId                 String
  creator                   User            @relation("IdeaCreator", fields: [creatorId], references: [id])
  // Basic info
  title                     String
  summaryDescription        String
  summaryDiagnosis          String?
  summaryGuidingPolicy      String?
  summaryCoherentActions    String?
  backgroundResearch        String?
  initialThoughts           Json?
  ideaType                  IdeaType        @default(LEGISLATION)
  govtArea                  String
  govtLevel                 GovtLevel       @default(NATIONAL)
  country                   String?         @default("GB")
  connectedIdeaIds          Json?
  // Strategic kernel
  diagnosis                 String?
  guidingPolicy             String?
  rootCause                 String?
  whoAffected               String?
  // Classification
  stage                     IdeaStage       @default(STAGE_1)
  visibility                IdeaVisibility  @default(PRIVATE)
  status                    IdeaStatus      @default(DRAFT)
  sector                    String?
  // Wording
  proposedWording           String?
  wordingLocked             Boolean         @default(false)
  version                   Int             @default(1)
  // Metrics (denormalised)
  voteCount                 Int             @default(0)
  passionScore              Decimal?
  voteDistribution          Json?
  commentCount              Int             @default(0)
  amendmentCount            Int             @default(0)
  endorsementCount          Int             @default(0)
  draftsmanEndorsementCount Int             @default(0)
  viewCount                 Int             @default(0)
  // Stage eligibility
  eligibleForNextStage      Boolean         @default(false)
  stageEligibleSince        DateTime?
  // Maturity (Sprint 1)
  maturityIndex             Decimal         @default(0)
  maturityIndexDetail       Json?
  maturityLastUpdated       DateTime?
  credibilityWeightedRating Decimal?
  // AI
  aiProvider                AIProvider      @default(GEMINI_FLASH)
  aiChatHistory             Json            @default("[]")
  aiChatSummary             String?
  aiCurrentField            String?
  aiSessionCount            Int             @default(0)
  // Origin / banner
  ideaOrigin                IdeaOrigin      @default(USER)
  bannerColour              String?         // Hex colour for banner; null = no banner shown
  bannerText                String?         // Override banner text; null = use default for origin
  // User profiling (V2K-D1)
  userAdditionalNotes       String?         // Lex-synthesised notes about user background, expertise, motivations
  // Referral
  referralLinkActive        Boolean         @default(false)
  // Ownership transfer
  ownershipTransferToken    String?         @unique
  ownershipTransferToId     String?
  ownershipTransferExpiry   DateTime?
  // Timestamps
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  publishedAt               DateTime?
  withdrawnAt               DateTime?

  // Relations
  votes                     Vote[]
  comments                  Comment[]
  amendments                Amendment[]
  endorsements              Endorsement[]
  draftsmanEndorsements     DraftsmanEndorsement[]
  research                  Research[]
  attachments               Attachment[]
  collaborators             IdeaCollaborator[]
  stageTransitions          StageTransition[]
  wordingHistory            WordingHistory[]
  coherentActions           CoherentAction[]
  diagnoses                 Diagnosis[]
  rootCauses                RootCause[]
  guidingPolicies           GuidingPolicy[]
  evidence                  Evidence[]
  resourcesCommitted        ResourcesCommitted[]
  targetOrganisations       TargetOrganisation[]
  pointsLedger              PointsLedger[]
  ideaReviews               IdeaReview[]
  ideaAlerts                IdeaAlert[]
  groups                    Group[]
  stageTransitionRequests   StageTransitionRequest[]
  generatedOutputs          GeneratedOutput[]
  notifications             Notification[]
  activityLogs              ActivityLog[]
  aiUsageLogs               AIUsageLog[]
  disputedLogicFlags        DisputedLogicFlag[]
  contentReports            ContentReport[]     @relation("ReportedIdea")
  legislationLinks          IdeaLegislation[]

  @@index([creatorId])
  @@index([stage])
  @@index([visibility])
  @@index([status])
}

model WordingHistory {
  id                String          @id @default(uuid())
  ideaId            String
  idea              Idea            @relation(fields: [ideaId], references: [id])
  version           Int
  wordingText       String
  changedByUserId   String
  changedBy         User            @relation(fields: [changedByUserId], references: [id])
  changeType        DraftChangeType
  amendmentId       String?
  createdAt         DateTime        @default(now())

  @@index([ideaId])
}

model StageTransition {
  id                            String    @id @default(uuid())
  ideaId                        String
  idea                          Idea      @relation(fields: [ideaId], references: [id])
  fromStage                     IdeaStage
  toStage                       IdeaStage
  triggeredByUserId             String
  triggeredBy                   User      @relation(fields: [triggeredByUserId], references: [id])
  transitionReason              String?
  voteCountAtTransition         Int?
  createdAt                     DateTime  @default(now())

  @@index([ideaId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SECTION 2 — STRATEGIC KERNEL
// ─────────────────────────────────────────────────────────────────────────────

model CoherentAction {
  id                                  String   @id @default(uuid())
  ideaId                              String
  idea                                Idea     @relation(fields: [ideaId], references: [id])
  title                               String
  summarySnippet                      String?
  detailedDescription                 String?
  actionType                          String?
  legislationDraftWording             String?
  organisationalChangeDraftWording    String?
  proposedWording                     String?
  costBenefitAnalysis                 String?
  netCostOngoing                      Decimal?
  netCostOneOff                       Decimal?
  costFinancial                       String?
  costSocial                          String?
  costOngoing                         String?
  benefitFinancial                    String?
  benefitSocial                       String?
  benefitOngoing                      String?
  benefits                            String?
  practicalExecution                  String?
  implementationPlan                  String?
  implementationSubQuestions          Json?    // {who, what, where, how, why, when}
  accountability                      String?
  successMeasurement                  String?
  keyRisks                            String?
  potentialHarm                       String?
  keyChallenges                       String?
  sourcesOfOpposition                 String?
  oppositionWho                       String?
  oppositionWhy                       String?
  oppositionAnswers                   String?
  mechanismType                       MechanismType?
  orderIndex                          Int      @default(0)
  version                             Int      @default(1)
  createdAt                           DateTime @default(now())
  updatedAt                           DateTime @updatedAt

  resourcesCommitted                  ResourcesCommitted[]
  legislationSections                 CoherentActionSection[]

  @@index([ideaId])
}

model ResourcesCommitted {
  id                             String   @id @default(uuid())
  ideaId                         String
  idea                           Idea     @relation(fields: [ideaId], references: [id])
  coherentActionId               String
  coherentAction                 CoherentAction @relation(fields: [coherentActionId], references: [id])
  description                    String
  resourceType                   String   // FINANCIAL, HUMAN, INFRASTRUCTURE, LEGISLATIVE, OTHER
  capitalCommitment              Decimal?
  annualCost                     Json?
  estimatedCost                  Decimal?
  timeframe                      String?
  humanCapitalCommitted          String?
  humanCapitalAnnualRequirement  String?
  createdAt                      DateTime @default(now())

  @@index([ideaId])
  @@index([coherentActionId])
}

model Research {
  id                    String       @id @default(uuid())
  ideaId                String
  idea                  Idea         @relation(fields: [ideaId], references: [id])
  addedByUserId         String
  contributor           User         @relation(fields: [addedByUserId], references: [id])
  researchType          ResearchType?
  title                 String
  snippet               String
  relevanceExplanation  String
  summaryOfContent      String?
  sourceUrl             String
  sourceType            SourceType
  forPolicy             Boolean?
  forAction             Boolean?
  constructiveScore     Int?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([ideaId])
}

model Attachment {
  id                String   @id @default(uuid())
  ideaId            String?
  idea              Idea?    @relation(fields: [ideaId], references: [id])
  uploadedByUserId  String
  uploadedBy        User     @relation(fields: [uploadedByUserId], references: [id])
  fileName          String
  fileType          String   // PDF, IMAGE
  fileSizeBytes     Int
  r2ObjectKey       String
  r2Bucket          String
  virusScanStatus   String   @default("PENDING") // PENDING, CLEAN, INFECTED
  createdAt         DateTime @default(now())

  @@index([ideaId])
}

model Diagnosis {
  id                    String   @id @default(uuid())
  ideaId                String   @unique
  idea                  Idea     @relation(fields: [ideaId], references: [id])
  diagnosisTitle        String?
  diagnosisDescription  String?
  text                  String?
  obstacleDefined       String?
  whoAffected           String?
  howAffected           String?
  whyPersisted          String?
  impactDescription     String?
  impactCost            String?
  diagnosisData         Json?
  version               Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([ideaId])
}

model RootCause {
  id                    String   @id @default(uuid())
  ideaId                String
  idea                  Idea     @relation(fields: [ideaId], references: [id])
  rootCauseTitle        String?
  rootCauseDescription  String?
  text                  String?
  rootCauseLinkBack     String?
  rootCauseLinkForward  String?
  rootCauseMechanism    String?
  whyNotSolved          String?
  incentiveDrivers      String?
  structureDrivers      String?
  // V2H-D1: multiple causes with depth and parent-child chain
  causeDepth            Int      @default(0)  // 0 = immediate cause, 1 = cause of cause, etc.
  orderIndex            Int      @default(0)  // display order among siblings
  parentId              String?               // null = top-level cause
  parent                RootCause?  @relation("CauseChain", fields: [parentId], references: [id])
  children              RootCause[] @relation("CauseChain")
  version               Int      @default(1)
  createdAt             DateTime @default(now())

  @@index([ideaId])
  @@index([parentId])
}

model GuidingPolicy {
  id                                   String   @id @default(uuid())
  ideaId                               String   @unique
  idea                                 Idea     @relation(fields: [ideaId], references: [id])
  guidingPolicyTitle                   String?
  guidingPolicyDescription             String?
  text                                 String?
  coreTheory                           String?
  // v5 — Rumelt guiding policy fields
  linkToDiagnosis                      String?
  whatThisPolicyRulesOut               String?
  whyThisApproachNotOthers             String?
  conditionsForSuccess                 String?
  mechanismTypes                       MechanismType[]
  tradeOffs                            String?
  competitiveIdeaAnalysis              String?
  version                              Int      @default(1)
  createdAt                            DateTime @default(now())

  @@index([ideaId])
}

model Evidence {
  id                String          @id @default(uuid())
  ideaId            String
  idea              Idea            @relation(fields: [ideaId], references: [id])
  title             String
  description       String
  comparablePolicy  String?
  successFailure    EvidenceOutcome?
  whatWorked        String?
  whatFailed        String?
  resultCauses      String?
  sourceUrl         String?
  sourceType        SourceType
  createdAt         DateTime        @default(now())

  @@index([ideaId])
}

model TargetOrganisation {
  id                            String                  @id @default(uuid())
  ideaId                        String
  idea                          Idea                    @relation(fields: [ideaId], references: [id])
  targetOrganisationalTitle     String
  organisationType              TargetOrganisationType?
  description                   String?
  currentBehaviourDescription   String?
  changeRequired                String?
  howToBringAbout               String?
  whoAccountable                String?
  howResultsMeasured            String?
  howChangeIncentivised         String?
  problemsLikely                String?
  mitigatingActions             String?
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt

  @@index([ideaId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SECTION 3 — IDEA MODIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Vote {
  id              String        @id @default(uuid())
  ideaId          String
  idea            Idea          @relation(fields: [ideaId], references: [id])
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  direction       VoteDirection
  strength        Decimal       @default(0)
  qualityFlags    Json?
  ipAddressHash   String?
  isAnonymous     Boolean       @default(false)
  referralCode    String?
  withdrawn       Boolean       @default(false)
  castAt          DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([ideaId, userId])
  @@index([ideaId])
  @@index([userId])
}

model Comment {
  id                    String        @id @default(uuid())
  ideaId                String
  idea                  Idea          @relation(fields: [ideaId], references: [id])
  authorId              String
  author                User          @relation(fields: [authorId], references: [id])
  parentId              String?
  parent                Comment?      @relation("CommentReplies", fields: [parentId], references: [id])
  replies               Comment[]     @relation("CommentReplies")
  stageNumber           Int?
  commentNumber         Int?          // Sequential per idea (1, 2, 3…)
  contributionType      ContributionType?
  content               String        // DOMPurify sanitised
  stance                CommentStance
  suggestedChanges      Boolean       @default(false)
  isOwnerReply          Boolean       @default(false)
  isInternal            Boolean       @default(false) // true for contributions created at Stage 2 (collaborator-only)
  qualityRating         Int?          // denormalised average of CommentRating.qualityRating (1–5)
  isHidden              Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  ratings               CommentRating[]
  contentReports        ContentReport[]  @relation("ReportedComment")

  @@index([ideaId])
  @@index([authorId])
}

model CommentRating {
  id              String   @id @default(uuid())
  commentId       String
  comment         Comment  @relation(fields: [commentId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
