// ─────────────────────────────────────────────────────────────────────────────
// SECTION 14 — LEGISLATION DATABASE
// ─────────────────────────────────────────────────────────────────────────────

// Top-level legislation item (an Act or SI)
model LegislationItem {
  id                    String              @id @default(uuid())
  // Identity
  legislationType       LegislationType
  tier                  LegislationTier
  title                 String
  year                  Int
  yearRaw               String?             // Original year segment from actId (e.g. "S.I._1970", "2021"); always set for UKSI
  number                Int                 // Chapter number (Acts) or SI number
  jurisdiction          String              // 'UK', 'Scotland', 'Wales', 'NI'
  sourceType            DocumentSourceType  @default(STATUTE)
  // Source
  legislationGovUkId    String              @unique // e.g. "ukpga/2006/46"
  clmlUrl               String              // URL to bulk CLML XML on legislation.gov.uk
  r2Key                 String?             // Key in R2 scrutinise-legislation bucket (raw CLML)
  // Compilation state
  compilationStatus     CompilationStatus   @default(PENDING)
  compilationProvider   String?             // 'gemini-2.5-flash' etc — winning model
  compiledAt            DateTime?
  sectionCount          Int                 @default(0)
  compiledSectionCount  Int                 @default(0)
  // Metadata
  shortTitle            String?
  longTitle             String?
  enactmentDate         DateTime?
  inForce               Boolean             @default(true)
  // Subject classification (V2E-B1)
  subjectArea           String?
  policyArea            String?
  feedUrl               String?             // source Atom feed URL (V2L-A1)
  effectsKey            String?             // R2: {legislationGovUkId}/effects.xml (TNA effects/amendments feed)
  effectsFetchedAt      DateTime?           // when effects feed was last fetched
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  sections              LegislationSection[]
  ideaLinks             IdeaLegislation[]
  crossRefsOut          LegislationCrossRef[] @relation("CrossRefSource")
  crossRefsIn           LegislationCrossRef[] @relation("CrossRefTarget")

  @@index([legislationType, year])
  @@index([tier])
  @@index([jurisdiction])
}

// Individual section within an Act
model LegislationSection {
  id                    String                  @id @default(uuid())
  legislationItemId     String
  legislationItem       LegislationItem         @relation(fields: [legislationItemId], references: [id])
  // Identity
  sectionNumber         String                  // "1", "13E", "172" etc
  sectionTitle          String?
  sourceType            DocumentSourceType      @default(STATUTE)
  // Text content
  originalText          String?                 // Tag-stripped full-act CLML section text — kept in Railway for FTS
  // R2 pointer keys (V2L-A1, V2.75-H2) — actual text stored in Cloudflare R2
  originalXmlKey        String?                 // R2: {legislationGovUkId}/sections/{N}.original.xml (enacted CLML P1group)
  tnaXmlKey             String?                 // R2: {legislationGovUkId}/sections/{N}.tna.xml (current CLML P1group)
  compiledTextKey       String?                 // R2: {legislationGovUkId}/sections/{N}.compiled.txt
  lexSummaryKey         String?                 // R2: {legislationGovUkId}/sections/{N}.summary.txt
  ftsVector             Unsupported("tsvector")? // GIN-indexed FTS column — managed via fts-migration.ts, not Prisma migrate
  // Compilation quality
  confidence            CompilationConfidence?
  confidenceReason      String?
  compilationVersion    Int                     @default(1)
  compilationNotes      String?
  unappliedAmendments   Json?                   // Array of {sourceInstrument, reason}
  commencementNote      String?                 // If commencement is uncertain
  // Compilation metadata
  compiledAt            DateTime?
  compiledBy            String?                 // Model identifier
  compilationStatus     CompilationStatus       @default(PENDING)
  // Flags
  isRepealed            Boolean                 @default(false)
  needsReview           Boolean                 @default(false)
  // Timestamps
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  // FTS and tagging fields (V2E-B1)
  tags            String[]
  amendmentCount  Int     @default(0)
  complexityScore Int     @default(0)
  inForce         Boolean @default(true)
  jurisdiction    String  @default("UK")
  policyArea      String?

  amendments            LegislationAmendment[]
  corrections           LegislationCorrection[]
  coherentActionLinks   CoherentActionSection[]

  @@unique([legislationItemId, sectionNumber])
  @@index([legislationItemId])
  @@index([compilationStatus])
  @@index([needsReview])
  @@index([ftsVector], type: Gin)
}

// Amendment applied to a section
model LegislationAmendment {
  id                    String              @id @default(uuid())
  sectionId             String
  section               LegislationSection  @relation(fields: [sectionId], references: [id])
  // Source of amendment
  sourceInstrument      String              // "Finance Act 2019"
  sourceInstrumentId    String?             // legislationGovUkId of the amending instrument
  sourceUrl             String?             // Direct URL to the amending provision
  effectDate            DateTime?
  // Amendment details
  amendmentType         String              // 'substitution' | 'insertion' | 'repeal' | 'modification'
  instruction           String              // The raw amendment instruction text
  targetedText          String?             // Original text targeted
  substitutedText       String?             // Replacement text (if substitution)
  // Application
  applied               Boolean             @default(false)
  applicationNotes      String?
  orderIndex            Int                 // Chronological order for application
  createdAt             DateTime            @default(now())

  @@index([sectionId])
  @@index([effectDate])
}

// Link between an Idea and relevant legislation
model IdeaLegislation {
  id                    String              @id @default(uuid())
  ideaId                String
  idea                  Idea                @relation(fields: [ideaId], references: [id])
  legislationItemId     String
  legislationItem       LegislationItem     @relation(fields: [legislationItemId], references: [id])
  linkType              String              // 'target' | 'relevant' | 'precedent'
  notes                 String?
  addedByUserId         String?
  createdAt             DateTime            @default(now())

  @@unique([ideaId, legislationItemId])
  @@index([ideaId])
  @@index([legislationItemId])
}

// User-submitted corrections to compiled text
model LegislationCorrection {
  id                    String                  @id @default(uuid())
  sectionId             String
  section               LegislationSection      @relation(fields: [sectionId], references: [id])
  userId                String
  user                  User                    @relation(fields: [userId], references: [id])
  description           String
  proposedText          String?
  sourceUrl             String?
  status                CorrectionStatus        @default(PENDING)
  lexAssessment         String?
  lexDecision           CorrectionDecision?
  adminDecision         CorrectionDecision?
  adminNotes            String?
  createdAt             DateTime                @default(now())
  resolvedAt            DateTime?

  @@index([sectionId])
  @@index([status])
}

// Cross-references between legislation items (V2E-B1)
model LegislationCrossRef {
  id               String   @id @default(cuid())
  sourceItemId     String
  sourceSectionId  String
  targetItemId     String
  targetSectionId  String?
  crossRefType     String   // "amends" | "repeals" | "modifies" | "extends"
  createdAt        DateTime @default(now())

  sourceItem       LegislationItem @relation("CrossRefSource", fields: [sourceItemId], references: [id])
  targetItem       LegislationItem @relation("CrossRefTarget", fields: [targetItemId], references: [id])

  @@index([sourceItemId])
  @@index([targetItemId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SUPPORT — Feedback
// ─────────────────────────────────────────────────────────────────────────────

model Feedback {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])
  email           String
  subject         String
  message         String    @db.Text
  feedbackType    String?   // "feature" | "bug" | "general" | "support" | null
  status          String    @default("NEW") // "NEW" | "TRIAGED" | "RESOLVED" | "WONTFIX"
  adminNotes      String?   @db.Text
  // Roadmap fields — populated later by AI categorisation
  aiCategory      String?
  aiPriority      String?   // "low" | "medium" | "high" | "urgent"
  aiSummary       String?   @db.Text
  aiCategorisedAt DateTime?

  @@index([status, createdAt])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SECTION 15b — EXPERT CORRECTIONS TO THE PUBLISHED LEGISLATION GUIDE
// ─────────────────────────────────────────────────────────────────────────────

// "Reading legislation: a working guide" (/support, lib/reading-legislation-content.ts)
// is published as a DRAFT seeking correction by practising lawyers. This is where a
// correction lands.
//
// Its own table rather than a `Feedback` row with a special `feedbackType`, because
// the two are different objects: this one carries a section reference and a claim to
// expertise, and it has a review lifecycle against a document. Folding it into
// Feedback would mean packing `credentials` and `sectionKey` into free text, and the
// whole value of the exercise is being able to work through §5's corrections together.
//
// No account required — the people best placed to correct this are the least likely
// to sign up first — but an email address IS required, because a correction we cannot
// reply to is worth much less than one we can.
model LegislationGuideSuggestion {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())

  name         String
  email        String                        // required: the point is a reply
  credentials  String?                       // role / chambers / practice area — self-declared, unverified

  // The STABLE key from lib/reading-legislation-content.ts, never the display title,
  // so re-titling a section cannot orphan the corrections filed against it. The title
  // is denormalised alongside it so an old record still reads correctly.
  sectionKey   String
  sectionTitle String
  suggestion   String    @db.Text

  status       String    @default("NEW")     // NEW | ACCEPTED | DECLINED | ACTIONED
  adminNotes   String?   @db.Text

  // Persist-then-send (the §20.5 rule): the record is written BEFORE the email is
  // attempted, so a mail failure loses a notification and never a correction.
  sentAt       DateTime?
  sendError    String?

  // Abuse triage only. SHA-256, never the raw address (security rule 6).
  ipHash       String?

  @@index([status, createdAt])
  @@index([sectionKey])
}

// ─────────────────────────────────────────────────────────────────────────────
// SECTION 16 — INVITE-ONLY SIGN-UP
// ─────────────────────────────────────────────────────────────────────────────

// Token gates link access; Clerk allowlist gates email match.
// Single-use enforced via usedAt; expiry enforced via expiresAt.
// Re-issuing an invite to the same email upserts — no duplicate rows.
model Invite {
  id          String    @id @default(cuid())
  email       String    @unique
  token       String    @unique
  invitedBy   String              // Clerk userId of issuing SUPER_ADMIN
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?

  @@index([token])
  @@index([email])
}

// Link between a CoherentAction and a LegislationSection with proposed wording
model CoherentActionSection {
  id                   String   @id @default(cuid())
  coherentActionId     String
  legislationSectionId String
  proposedWording      String?
  changeType           String   @default("AMEND")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  coherentAction     CoherentAction     @relation(fields: [coherentActionId], references: [id], onDelete: Cascade)
  legislationSection LegislationSection @relation(fields: [legislationSectionId], references: [id])

  @@index([coherentActionId])
  @@index([legislationSectionId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SECTION 15 — OPERATIONAL CORPUS
// ─────────────────────────────────────────────────────────────────────────────

// Top-level operational document (an HMRC manual, FCA Handbook chapter, etc.)
model OperationalDocument {
  id              String                  @id @default(uuid())
  sourceType      DocumentSourceType      @default(ADMINISTRATIVE_GUIDANCE)
  // Source identification
  sourceSlug      String                  // e.g. "employment-income-manual"
  publisherName   String                  // e.g. "HMRC"
  title           String
  description     String?
  sourceUrl       String                  // canonical URL on gov.uk or regulator site
  // R2 storage
  r2Prefix        String                  // e.g. "operational/hmrc/employment-income-manual"
  // Metadata
  jurisdiction    String                  @default("UK")
  // Ingest state
  ingestStatus    OperationalIngestStatus @default(PENDING)
  pageCount       Int                     @default(0)
  lastFetchedAt   DateTime?
  // Timestamps
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  sections        OperationalSection[]

  @@unique([sourceType, sourceSlug])
  @@index([sourceType])
  @@index([ingestStatus])
}

// Individual page within an operational document
model OperationalSection {
  id                      String                  @id @default(uuid())
  operationalDocumentId   String
  operationalDocument     OperationalDocument     @relation(fields: [operationalDocumentId], references: [id])
  sourceType              DocumentSourceType      @default(ADMINISTRATIVE_GUIDANCE)
  // Identity within the document
  pageSlug                String                  // e.g. "eim01000" — HMRC page ID or equivalent
  chapterSlug             String?                 // e.g. "chapter-1-employment-income"
  pageTitle               String?
  sourceUrl               String                  // URL of this specific page
  orderIndex              Int                     @default(0)
  // R2 pointer keys
  htmlKey                 String?                 // operational/hmrc/{doc}/{chapter}/{slug}.html
  textKey                 String?                 // operational/hmrc/{doc}/{chapter}/{slug}.text
  // FTS content (short excerpt stored in Railway for search — full text in R2 via textKey)
  extractedText           String?
  wordCount               Int?
  ftsVector               Unsupported("tsvector")? // GIN-indexed FTS column — managed via fts-migration.ts, not Prisma migrate
  // Provenance (Phase C will formalise enum; String for now)
  extractedBy             String?                 // "html-direct" | "pdf-text" | "pdf-ocr" | "ai-summary"
  // Ingest state
  ingestStatus            OperationalIngestStatus @default(PENDING)
  fetchedAt               DateTime?
  // Timestamps
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@unique([operationalDocumentId, pageSlug])
  @@index([operationalDocumentId])
  @@index([ingestStatus])
  @@index([ftsVector], type: Gin)
}

// ─────────────────────────────────────────────────────────────────────────────
// Corpus Ingest Tracking
// Added: L6-E Corpus Ingest System sprint
// Tracks metadata for every section ingested by the 10-worker corpus pipeline.
// Compiled text and raw content live in R2 (r2Key / r2RawKey point there).
// Never store compiled text in this table — R2 only.
// ─────────────────────────────────────────────────────────────────────────────

model CorpusSection {
  // "{corpus}:{docId}:{sectionRef}" — globally unique across all corpora
  id           String    @id
  corpus       String    // e.g. "primary-acts-pre-2000", "tna-caselaw", "hmrc-codes-guidance"
  sourceUrl    String?   // original fetch URL
  r2Key        String?   // compiled plain-text location in R2
  r2RawKey     String?   // raw XML/HTML location in R2 (optional)
  compiledAt   DateTime?
  wordCount    Int?
  // pending | compiled | failed | skipped | unavailable
  status       String    @default("pending")
  errorMsg     String?
  // clml | clml-unparsed | html | pdf | unavailable | effects
  format       String?
  // first 200 chars of raw XML for clml-unparsed rows — used in scheduler alert email
  xmlPreview   String?
  // act-level flags, e.g. 'enacted-only' where TNA has no consolidated version
  notes        String?
  createdAt    DateTime  @default(now())

  // fts_vector is maintained by a DB trigger (see migration SQL).
  // Declared as Unsupported so Prisma carries the column without attempting type mapping.
  ftsVector    Unsupported("tsvector")?

  @@index([corpus])
  @@index([status])
  @@index([format])
  @@index([notes])
  @@map("corpus_sections")
}

// Act-level metadata over the legislation corpora (SPRINT §1). One row per
// instrument; a DERIVED table, rebuilt from corpus_sections + LegislationItem by
// scripts/ingest/search/build-act-metadata.ts. DDL of record is
// prisma/act_metadata.sql — that file, not this model, is what gets applied.
//
// Declared here for one reason: without it, `prisma migrate diff` sees a table that
// the schema does not know about and proposes DROPPING it. Nothing reads the table
// through the Prisma client (the browse route uses raw SQL, because the trigram
// title match has no Prisma equivalent), so this model exists to protect the table,
// not to query it.
model CorpusAct {
  gid                String   @id
  title              String?
  titleSource        String?  @map("title_source")
  legType            String?  @map("leg_type")
  year               Int?
  number             String?
  jurisdiction       String?
  legislationItemId  String?  @map("legislation_item_id")
  legislationType    String?  @map("legislation_type")
  itemSectionCount   Int?     @map("item_section_count")
  itemCompiledCount  Int?     @map("item_compiled_count")
  corpus             String?
  sectionCount       Int      @default(0) @map("section_count")
  wordCount          BigInt?  @map("word_count")
  inCorpus           Boolean  @default(false) @map("in_corpus")
  inLegislationItem  Boolean  @default(false) @map("in_legislation_item")
  firstDate          DateTime? @map("first_date") @db.Date
  lastDate           DateTime? @map("last_date") @db.Date
  refreshedAt        DateTime @default(now()) @map("refreshed_at") @db.Timestamptz()

  @@index([year])
  @@index([legType])
  @@index([jurisdiction])
  @@map("corpus_acts")
}

// ── POSITION GRAPH (Stage 2D sprint 1, BRIEF_GRAPH_2D1) ──────────────────────
// The entity spine and the OBSERVED edges: who gave evidence to which inquiry, who
// declared an interest in which organisation. DDL of record is
// scripts/ingest/position-graph/schema.sql, applied by that directory's setup.ts —
// those files, not these models, are what gets applied.
//
// Declared here for the same single reason as CorpusAct above: without a model,
// `prisma migrate diff` sees five tables the schema does not know about and proposes
// DROPPING them. Nothing reads these through the Prisma client; the sweeps and the
// report use raw SQL (multi-row upserts with ON CONFLICT arbitration that Prisma
// cannot express). These models exist to protect the tables, not to query them.
//
// NOT the citation graph. `scripts/ingest/graph/` and its edges table are the Tier-1
// legislation graph (an Act cites/amends an Act). This is the POSITION graph: what an
// actor demonstrably did. Two different things, deliberately not merged.
model GraphEntity {
  id               BigInt    @id @default(autoincrement())
  kind             String
  canonicalName    String    @map("canonical_name")
  nameNorm         String    @map("name_norm")
  companiesHouseNo String?   @map("companies_house_no")
  charityNo        String?   @map("charity_no")
  parlMemberId     Int?      @map("parl_member_id")
  parlCisId        Int?      @map("parl_cis_id")
  parlIdmsId       String?   @map("parl_idms_id")
  twfyPersonId     String?   @map("twfy_person_id")
  keySource        String    @map("key_source")
  confidence       Float     @default(1.0)
  firstSeen        DateTime? @map("first_seen") @db.Date
  lastSeen         DateTime? @map("last_seen") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@map("graph_entity")
}

model GraphAlias {
  id          BigInt    @id @default(autoincrement())
  entityId    BigInt    @map("entity_id")
  surface     String
  surfaceNorm String    @map("surface_norm")
  source      String
  nSeen       Int       @default(1) @map("n_seen")
  firstSeen   DateTime? @map("first_seen") @db.Date
  lastSeen    DateTime? @map("last_seen") @db.Date

  @@unique([entityId, surface, source])
  @@index([surfaceNorm])
  @@map("graph_alias")
}

model GraphEdge {
  id             BigInt    @id @default(autoincrement())
  subjectId      BigInt    @map("subject_id")
  predicate      String
  objectKind     String    @map("object_kind")
  objectEntityId BigInt?   @map("object_entity_id")
  objectRef      String    @map("object_ref")
  objectLabel    String?   @map("object_label")
  firstSeen      DateTime? @map("first_seen") @db.Date
  lastSeen       DateTime? @map("last_seen") @db.Date
  nEvidence      Int       @default(0) @map("n_evidence")

  @@unique([subjectId, predicate, objectKind, objectRef])
  @@index([subjectId, predicate])
  @@index([objectKind, objectRef])
  @@index([predicate])
  @@map("graph_edge")
}

model GraphEvidence {
  id         BigInt    @id @default(autoincrement())
  edgeId     BigInt    @map("edge_id")
  sectionId  String    @map("section_id")
  sourceUrl  String?   @map("source_url")
  extract    String?
  observedOn DateTime? @map("observed_on") @db.Date

  @@unique([edgeId, sectionId])
  @@index([sectionId])
  @@map("graph_evidence")
}

model GraphMergeLog {
  id            BigInt   @id @default(autoincrement())
  kind          String
  keptEntityId  BigInt?  @map("kept_entity_id")
  mergedSurface String   @map("merged_surface")
  mergedNorm    String   @map("merged_norm")
  reason        String
  confidence    Float
  source        String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([keptEntityId])
  @@map("graph_merge_log")
}

// ── POSITION GRAPH (Stage 2D sprint 2, BRIEF_GRAPH_2D2) ──────────────────────
// DDL of record is scripts/ingest/position-graph/schema-2d2.sql, applied by that
// directory's setup-2d2.ts. Declared here for the same single reason as the five
// models above: without a model, `prisma migrate diff` proposes DROPPING them.
// Nothing reads these through the Prisma client.
//
// ⚠ The `voted` and `signed-motion` EDGES are not here and are not tables. They are
// VIEWS (graph_voted_edge, graph_signed_motion_edge, graph_edge_all) over these rows
// plus division_votes, because materialising 2.53M vote edges would have cost 2.21 GiB
// against 0.93 GiB of headroom — see schema-2d2.sql's header for the measurement.
// Prisma does not model views and does not need to: a view is not a table `migrate
// diff` can propose dropping.

/// The Parliament member register (MNIS), from members-api.parliament.uk, OPL v3.0.
model GraphMemberRegister {
  mnisId            Int       @id @map("mnis_id")
  nameDisplay       String?   @map("name_display")
  nameList          String?   @map("name_list")
  nameFullTitle     String?   @map("name_full_title")
  nameAddress       String?   @map("name_address")
  gender            String?
  latestHouse       Int?      @map("latest_house") @db.SmallInt
  latestParty       String?   @map("latest_party")
  latestPartyAbbrev String?   @map("latest_party_abbrev")
  membershipFrom    String?   @map("membership_from")
  membershipStart   DateTime? @map("membership_start") @db.Date
  membershipEnd     DateTime? @map("membership_end") @db.Date
  isCurrent         Boolean?  @map("is_current")
  fetchedAt         DateTime  @default(now()) @map("fetched_at") @db.Timestamptz()

  @@map("graph_member_register")
}

/// Every DATED name form a member has carried. This is what decides whether two
/// entities are one person and whether one entity is two.
model GraphMemberName {
  mnisId      Int       @map("mnis_id")
  surface     String
  surfaceNorm String    @map("surface_norm")
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  source      String

  @@id([mnisId, surface, source])
  @@index([surfaceNorm])
  @@index([mnisId])
  @@map("graph_member_name")
}

/// The EDM primary sponsor's member id — on the API's wire, dropped by our ingest.
model EdmSponsor {
  motionId      Int       @id @map("motion_id")
  mnisId        Int?      @map("mnis_id")
  sponsorName   String    @map("sponsor_name")
  party         String?
  constituency  String?
  dateTabled    DateTime? @map("date_tabled") @db.Date
  sponsorsCount Int?      @map("sponsors_count")
  uin           String?
  fetchedAt     DateTime  @default(now()) @map("fetched_at") @db.Timestamptz()

  @@index([mnisId])
  @@map("edm_sponsor")
}

// Central ingest work queue — workers claim rows atomically via FOR UPDATE SKIP LOCKED.
// Populated by queue-populator.ts before workers start.
model IngestQueue {
  // "{corpus}:{docId}" e.g. "primary-acts-pre-2000:ukpga/1998/42"
  id             String    @id
  corpus         String
  docId          String
  // "tna-legislation" | "tna-caselaw" | "bailii" | "hansard" | "fca" | "echr" | "eurlex" | "treaties" | "oecd"
  sourceType     String
  // 1=highest priority (UK Primary Acts), 5=lowest
  priority       Int       @default(5)
  // pending | claimed | done | failed | skipped
  status         String    @default("pending")
  claimedBy      Int?
  claimedAt      DateTime?
  completedAt    DateTime?
  attempts       Int       @default(0)
  lastError      String?
  // Formats discovered from TNA metadata feed (comma-separated), e.g. "xml,html,pdf"
  formatsAvailable String?
  // Format actually used when retrieving content
  formatFound    String?
  createdAt      DateTime  @default(now())

  @@index([status, priority, id], name: "ingest_queue_status_priority")
  @@index([corpus], name: "ingest_queue_corpus")
  @@index([claimedBy], name: "ingest_queue_claimed_by")
  @@map("ingest_queue")
}

// Per-source rate-limit token buckets — shared across all workers.
model SourceRateLimit {
  sourceKey            String    @id
  intervalMs           Int
  lastIssuedAt         BigInt    @default(0)
  suspended            Boolean   @default(false)
  suspendedUntil       DateTime?
  isComplete           Boolean   @default(false)
  maxConcurrentWorkers Int       @default(20)
  updatedAt            DateTime  @updatedAt

  @@map("source_rate_limits")
}

// Append-only time-series — one row per corpus per scheduler run.
// Never updated. Provides historical ingest velocity over time.
model IngestProgressSnapshot {
  id                Int      @id @default(autoincrement())
  capturedAt        DateTime @default(now())
  workerLabel       String   // e.g. "Primary Acts pre-2000" or "Worker 3"
  workerId          Int?     // NULL = scheduler corpus snapshot; non-null = per-worker session snapshot
  sourceKey         String   // corpus label — matches corpus_sections.corpus
  sectionsCompiled  Int
  sectionsEstimated Int
  phase             String   // "phase1" | "phase2" | "queue" | "worker"

  @@index([capturedAt])
  @@index([sourceKey])
  @@index([workerId])
  @@map("ingest_progress_snapshots")
}

// Single-row mutex — prevents duplicate scheduler runs when two instances are active.
// Acquired at the start of each run(); only the holder sends the email.
model SchedulerLock {
  id        Int      @id @default(1)
  lockedAt  DateTime @db.Timestamptz(6)
  processId String

  @@map("scheduler_lock")
}

// ─────────────────────────────────────────────────────────────────────────────
// THE DEEPENING (§22, Pilot A)
//
// The kernel produces a skeleton. Deepening turns it into something that survives
// scrutiny: Lex does the heavy lifting, the user does the judging. Each PASS runs as
// a background gather over corpus + statistics and produces FINDINGS (evidence,
// precedents, comparisons) and ISSUES (specific, addressable gaps).
//
// ⚠ THE INVARIANT: this is a SEPARATE EVIDENCE LAYER. An EvidenceItem REFERENCES a
// canonical field via `fieldRef`; it never holds that field's value, and no field-write
// path reads these tables. Changing what a field SAYS goes through the normal save path
// (proposal → AWAITING_CONFIRMATION → the user's Save). Mixing them would reintroduce
// the multi-source-of-truth condition the rebuild removed. `check:deepening` asserts it.
// ─────────────────────────────────────────────────────────────────────────────

/// One row per (idea, passKey). Holds the run's status, its version, and — as
/// first-class output, not a footnote — what the pass searched for and could not find.
model DeepeningPass {
  id            String              @id @default(uuid())
  ideaId        String
  idea          Idea                @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  passKey       String
  status        DeepeningPassStatus @default(NOT_RUN)
  runVersion    Int                 @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  /// Set whenever status = FAILED. A partial run keeps what it managed and says so —
  /// silence about a partial result is the failure mode §18 exists to prevent.
  failureReason String?
  /// Always an array once a run has happened. `[]` renders as "nothing was unfindable",
  /// which is information; a missing block is not.
  knownUnknowns Json                @default("[]")
  /// §19-E Task 3 — the sift, reported rather than hidden. "Reviewed 104 sources, 12
  /// bore on this" is honest about how much of a search does not help, and it is a
  /// quality signal we can watch. A discard count nobody sees is the same as no sift.
  candidatesReviewed Int            @default(0)
  candidatesKept     Int            @default(0)
  /// TRUE when the sift could not run and the pass fell back to the ranked set. Without
  /// this, "reviewed 104, kept 104" reads as a sift that liked everything rather than a
  /// sift that never happened (CLAUDE.md §18 corollary).
  siftSkipped        Boolean        @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([ideaId, passKey])
}

/// A finding. PROPOSED until the user accepts or rejects it. Accepting attaches it to
/// the field named by `fieldRef` as read-only evidence — it does NOT edit that field.
model EvidenceItem {
  id         String         @id @default(uuid())
  ideaId     String
  idea       Idea           @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  passKey    String
  runVersion Int            @default(1)
  /// A reference, never a write: "challenge", "causes:<id>", "actions:<id>", or null
  /// for evidence about the idea at large.
  fieldRef   String?
  /// SUPPORTS and CONTRADICTS are distinct on purpose. A CONTRADICTS finding is as
  /// valuable as a SUPPORTS one and is never filtered out of a list.
  kind       EvidenceKind   @default(FINDING)
  title      String
  body       String
  sourceType String?
  sourceId   String?
  citation   String?
  url        String?
  status     EvidenceStatus @default(PROPOSED)
  /// Why it was rejected, or why a re-run superseded it.
  note       String?
  /// §19-E Task 3 — the sift's one-line reason this source bears on the proposal.
  /// Null on findings written before the sift existed; inventing one would be a claim
  /// about a judgement nobody made.
  siftReason String?
  /// Did the sift judge this source to satisfy the PRECEDENT TEST — a comparable
  /// measure was tried, and we can say what it was for, what was predicted, or what
  /// happened? A topically-related document is not a precedent.
  precedentTestPassed Boolean?
  /// Sprint 25-D §3 — WHICH §25.5 QUESTION THIS ANSWERS, tagged by the producer that
  /// wrote the row. Never derived downstream: a panel that classified findings by
  /// reading them would guess, and a wrong guess files a finding under a question it
  /// does not answer. Null on rows written before 25-D, and rendered as unclassified
  /// rather than filed under a heading nobody chose.
  headingKey String?

  // ════════════ 25-P §2 — WHEN THE SOURCE IS FROM ════════════════════════════
  //
  // ⚠⚠ THE COLUMN 25-O §6 WENT LOOKING FOR AND DID NOT FIND. The 2014 Lords claim came from a
  // debate of 16 January 2014; the date was in the URL and in the corpus row, and there was
  // nowhere for it to land. §2: *"No prompt instruction can work against a missing column"* —
  // which is why the earlier framing of this as a content problem was wrong.

  /// The date of the SOURCE, not of the row. Null means undated, and §2c is explicit that an
  /// undated row must be VISIBLY undated rather than silently assumed current.
  sourceDate      DateTime?
  /// ⚠⚠ HOW THE DATE WAS GOT, OR WHY THERE IS NONE — and it is never null once §2b is running,
  /// because "no date" and "nobody looked" are different states and a reader has to be able to
  /// tell them apart. One of `EvidenceDateBasis` in lib/lex/evidence-date.ts:
  /// CORPUS_ROW | URL | CORPUS_ROW_UNDATED | NO_SOURCE_ROW | UNPARSEABLE | NOT_ASSESSED.
  /// ⚠ NEVER `MODEL`. §2b: populated at write time from the corpus row, not from the model —
  /// a date a model produced is a claim about a document, not a property of it.
  sourceDateBasis String?

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  resolves   DeepeningIssue[] @relation("IssueResolution")

  @@index([ideaId, passKey])
  @@index([ideaId, fieldRef])
  @@index([ideaId, status])
  @@index([ideaId, headingKey])
  /// §2c — "how many rows could not be dated, and why" is a query, not a scan.
  @@index([ideaId, sourceDateBasis])
}

/// A specific, addressable gap. The user works through these: address, defer, or
/// dismiss with a reason. A dismissed issue stays visible with its reason attached —
/// what was considered and set aside is a strength, not something to hide.
model DeepeningIssue {
  id                   String               @id @default(uuid())
  ideaId               String
  idea                 Idea                 @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  passKey              String
  runVersion           Int                  @default(1)
  text                 String

  // ════════ 25-Q §7 — A CHALLENGE HAS A NAME, AND ITS SOURCE IS AT THE FOOT ════════
  //
  // Charlie, on the most valuable output of the whole run: the attribution is in the wrong
  // place. The coverage check was writing *"ANOTHER MODEL MADE THIS POINT AND OUR PROPOSAL
  // DOES NOT ADDRESS IT — …"* as the first words of `text`, in capitals, with the model's name
  // in brackets in the middle of the sentence. So every one of those challenges was headed by
  // its own provenance and titled by nothing.

  /// ⚠ A SHORT NAME FOR THE POINT — "Employment law issues". Null on a row written before
  /// 25-Q; it renders as no title rather than as an invented one, because a title guessed
  /// downstream from the text is the thing 25-D §3 spent a sprint removing.
  title                String?
  /// ⚠ THE MODEL THAT RAISED IT, WHERE ONE DID. Rendered at the FOOT as the source, never as
  /// the heading. Null where the challenge is our own reading rather than another model's.
  sourceModel          String?
  status               DeepeningIssueStatus @default(OPEN)

  // ════════ 25-X §3 (decisions 54 + 58) — THE CHALLENGE CLEANUP ════════
  //
  // A re-run ADDS challenges rather than replacing them: 225 across nine drafts before this,
  // so the printed report carried objections to text that no longer existed. The cleanup
  // ARCHIVES, it never deletes — everything stays on screen under previous drafts.

  /// ⚠ AN EARLIER CRITICISM THAT STILL BITES, SHOWN IN THIS BUILD'S SET. Null = not promoted.
  /// The document filter is `runVersion = current OR promotedToVersion = current`.
  ///
  /// ⚠⚠ `runVersion` IS DELIBERATELY NOT REWRITTEN. It records the draft the criticism was
  /// raised against, and that is precisely what the promotion is meant to DISPLAY — moving it
  /// would destroy the provenance the feature exists to show.
  promotedToVersion    Int?
  /// The other challenge this one is related to: the current criticism it duplicates or may
  /// duplicate, or the one it was merged into. See `relationKind`.
  ///
  /// ⚠ `onDelete: SetNull`, never Cascade. Deleting a criticism because a DIFFERENT criticism
  /// was removed is the opposite of "archive, never delete".
  relatedIssueId       String?
  relatedIssue         DeepeningIssue?      @relation("IssueRelation", fields: [relatedIssueId], references: [id], onDelete: SetNull)
  relatedFrom          DeepeningIssue[]     @relation("IssueRelation")
  /// `DUPLICATE` (archived) · `POSSIBLY_DUPLICATE` (⚠ STAYS OPEN AND VISIBLE — same topic,
  /// different point, and 25-X §3b's whole purpose is that a close call is not retired) ·
  /// `MERGED_INTO` (archived into a sibling in the same build).
  relationKind         String?

  /// Required by the application when status = DISMISSED. A dismissal without a stated
  /// reason is an unaccountable veto.
  dismissReason        String?
  resolutionNote       String?
  resolutionEvidenceId String?
  resolutionEvidence   EvidenceItem?        @relation("IssueResolution", fields: [resolutionEvidenceId], references: [id], onDelete: SetNull)
  /// §24.3-ready and deliberately unused today: review findings land on this same list.
  /// The column exists now so building §24 is an insert, not a migration of live rows.
  reviewFindingId      String?
  createdAt            DateTime             @default(now())
  resolvedAt           DateTime?
  updatedAt            DateTime             @updatedAt

  @@index([ideaId, passKey])
  @@index([ideaId, status])
}

enum DeepeningPassStatus {
  NOT_RUN
  RUNNING
  RUN
  FAILED
}

enum EvidenceKind {
  FINDING
  PRECEDENT
  SUPPORTS
  CONTRADICTS
  COMPARISON
}

enum EvidenceStatus {
  PROPOSED
  ACCEPTED
  REJECTED
}

enum DeepeningIssueStatus {
  OPEN
  ADDRESSED
  DEFERRED
  DISMISSED
}

// ─────────────────────────────────────────────────────────────────────────────
// SPRINT 25-A — minimum elicitation and the first build (BRIEF_25A.md).
// Hand-written additive schema, applied via prisma/lex_build_25a.sql. See that file
// for the reasoning behind every column; the notes here are the ones a reader of the
// schema alone would otherwise get wrong.
// ─────────────────────────────────────────────────────────────────────────────

/// The four exchanges of §1, one row per idea. Deliberately NOT IdeaFieldState rows:
/// the field machine's statuses describe a PROPOSAL contract, and these answers are
/// the user's own words taken before anything has been drafted.
model IdeaElicitation {
  id                     String                @id @default(uuid())
  ideaId                 String                @unique
  idea                   Idea                  @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  /// Exchange 1 — the problem, in their words. Subject to the §19-D problem gate.
  problem                String?
  problemPresses         Int                   @default(0)
  /// Did the deterministic solution-shape reading fire? Stored so that whether the gate
  /// armed is observable from outside rather than inferred from Lex's wording.
  problemGateFired       Boolean               @default(false)

  /// Exchange 2 — what you want to happen, and anything already ruled out.
  goalKind               String?
  goalDetail             String?
  ruledOut               String?

  /// Exchange 3 — what you know that we won't find.
  /// ⚠ `ownKnowledgeProvenance` is load-bearing: every later citation depends on telling
  /// the user's own knowledge apart from retrieved material.
  ownKnowledge           String?
  ownKnowledgeProvenance ElicitationProvenance @default(USER_TESTIMONY)

  /// Exchange 4 — CAPTURED, NOT READ. Ingestion is 25-D; `readingStatus` stays NOT_READ
  /// for the whole of this sprint, because saying otherwise breaks never-claim at the
  /// first exchange.
  readingUrl             String?
  readingFileName        String?
  readingNote            String?
  readingStatus          String                @default("NOT_READ")

  /// The reusable About-you profile, skipped for a returning user (§1a).
  profileSkipped         Boolean               @default(false)

  /// §1c — Lex writes back its understanding and waits. A correction re-runs the
  /// confirmation, not the whole of Page 1, so this counts presses of "Not quite".
  understanding          String?
  corrections            Int                   @default(0)
  status                 ElicitationStatus     @default(IN_PROGRESS)
  confirmedAt            DateTime?

  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
}

/// A build is a JOB, not a chat turn (§2). The row IS the status: what is shown is what
/// is stored, and an abandoned RUNNING row is settled by WRITING it to FAILED.
///
/// ⚠ ONE ACTIVE BUILD PER IDEA is enforced by a PARTIAL unique index on (ideaId) WHERE
/// status IN ('QUEUED','RUNNING'), which Prisma cannot declare. A `prisma migrate diff`
/// will want to drop it; it must not be dropped — a plain unique on ideaId would make a
/// second build permanently impossible, and re-running after a correction is normal.
model IdeaBuild {
  id              String       @id @default(uuid())
  ideaId          String
  idea            Idea         @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  version         Int
  status          BuildStatus  @default(QUEUED)
  /// NO DEFAULT — §3a's comparison only survives if every build says which arm it ran.
  framing         BuildFraming

  passesComplete  Int          @default(0)
  currentPass     String?
  /// One entry per named pass, rewritten as each completes. A timeout loses the tail,
  /// never the run, and a partial build says which passes completed because the answer
  /// is stored rather than reconstructed.
  passes          Json         @default("[]")
  /// §4.2 — what Lex is unsure about, per field, in a sentence. { fieldKey: sentence }.
  uncertainties   Json         @default("{}")
  summaryMessage  String?
  /// The search string pass 1 actually issued — the A/B artefact.
  queryUsed       String?

  startedAt       DateTime?
  completedAt     DateTime?
  /// Set on FAILED and CANCELLED. Hitting a ceiling is a FAILED build with a plain
  /// reason, never a silently shortened one.
  failureReason   String?
  /// Cancel is co-operative: the request is written here and the engine checks it
  /// between passes. A cancel that only stopped the poller would leave the work running.
  cancelRequested Boolean      @default(false)
  /// AMENDMENT_25B §C4 — what the user asked for WHEN THEY STARTED THIS BUILD.
  /// ⚠ Deliberately not read from `User` at send time: the worker sends minutes later, on
  /// another machine, and must honour the choice made at enqueue rather than a preference
  /// changed in another tab since. Storing it here is what stops the setting being
  /// retroactive.
  notifyEmail     Boolean      @default(false)

  /// 25-L §1 — WHAT THE USER SAID WAS WRONG WITH THE LAST RUN, and what they asked
  /// this one to do about it. Written when the re-run dialogue is submitted, before the
  /// build starts, so version N carries what N was asked to fix about N-1.
  ///
  /// ⚠ ON THE BUILD, NOT ON THE IDEA. It is a statement about ONE run; four critiques on
  /// the idea would be a heap with nothing saying which attempt each was about — and that
  /// is the information that makes it a quality signal rather than a comment.
  userCritique    String?      @db.Text
  userCritiqueAt  DateTime?

  /// ══ 25-O §5 — THE OPENING COMMENTARY ON THE CAUSES ══════════════════════════════
  ///
  /// The `CausesCommentary` shape from `lib/lex/build-commentary.ts`: what the evidence says,
  /// how complex the problem is, how the pieces relate, and where the sources CONFLICT.
  ///
  /// ⚠ ON THE BUILD, NOT ON THE IDEA, and for the same reason `userCritique` is. It describes
  /// the terrain AS OF THIS RUN. Stored on the idea it would be one paragraph silently
  /// outliving the evidence it was written about — and the causes are exactly what a re-run
  /// changes. On the build, the screen can say which run it came from and whether that run is
  /// still the latest.
  ///
  /// ⚠ NULL IS A REAL AND COMMON STATE: a build made before 25-O, a pass that did not run, a
  /// model that returned something with nothing in it. The section renders an honest empty
  /// state rather than a heading over a blank.
  causesCommentary Json?

  /// 25-M §4 — WHICH MODE THIS BUILD ACTUALLY RAN IN. `FULL` or `REUSE`.
  ///
  /// ⚠ WHAT RAN, NOT WHAT WAS ASKED FOR. `claimBuild` downgrades a REUSE request to FULL
  /// when there is nothing to reuse, and the allowance charges the two differently — so
  /// storing the request would charge a third for a build that did the whole job.
  ///
  /// ⚠ 25-G had this as a request parameter and never recorded it. Nothing depended on it
  /// until the allowance did, and a charge inferred from the shape of a JSON pass log is a
  /// charge nobody can audit.
  mode            String       @default("FULL")

  tokensIn        Int          @default(0)
  tokensOut       Int          @default(0)
  /// ⚠ NULL MEANS UNPRICED, NOT FREE. A model we have no rate for must not silently
  /// cost zero — zero is a claim, and it is the claim most likely to be believed.
  estCostPence    Decimal?     @db.Decimal(12, 4)

  /// ══ 25-N §1a — A BUILD THAT STOPPED BEFORE ITS PASSES CAN BE PICKED UP AGAIN ═══════
  ///
  /// ⚠ MEASURED, NOT SUPPOSED. Build v7 of idea `452c5ade` (30 Aug 2026, 11:14–11:30 UTC)
  /// ran 8 of its 10 passes and stopped on the 900s hard stop between KERNEL_CHECK and
  /// LOGIC_CHECK. `stopBuild` rewrote the two remaining passes to NOT_REACHED; `nextPassKey`
  /// only ever returns a PENDING or RUNNING pass; so `isResumable` was false and there was
  /// nothing on any screen offering to continue it. Charlie: *"Stopping before it's
  /// finished the passes! With no re-start."*
  ///
  /// ⚠ THE CLOCK HAS TO MOVE OR THE RESUME CANNOT WORK. `checkStop` measures elapsed from
  /// `startedAt`; resuming a build that has already used its 900s would stop again on its
  /// first pass, for ever. So a resume stamps `resumedAt` and the ceiling runs from there.
  /// The SPEND ceiling is deliberately NOT reset — it sums the stored usages across every
  /// pass, so a resumed build still cannot exceed the cost the user was quoted.
  resumedAt       DateTime?
  /// How many times this build has been picked up again. Bounded (`MAX_RESUMES`) so a build
  /// that stops on the same pass cannot be resumed round a loop.
  resumeCount     Int          @default(0)
  /// ⚠ 25-T §1f — HOW MANY TIMES THE WORKER RESUMED THIS BUILD ON ITS OWN, and it is
  /// deliberately NOT `resumeCount`. §1f bounds the automatic attempts at two; 25-N bounds the
  /// USER's at three. One counter for both would mean a build the worker retried twice left the
  /// user a single press — spending their patience on our retries.
  autoResumeCount Int          @default(0)
  /// ⚠ WHY IT STOPPED LAST TIME, KEPT ACROSS THE RESUME. `failureReason` is cleared when
  /// the build goes back to QUEUED, and a resumed build that said nothing about having
  /// stopped would be exactly the "silently presents incomplete work as finished" this
  /// change exists to prevent.
  lastStopReason  String?      @db.Text

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  forks           BuildFork[]

  @@unique([ideaId, version])
  @@index([ideaId, status])
  /// AMENDMENT_25B §C4 — the estimate reads the last 20 DONE builds by `completedAt`, on
  /// every load of /ideas/build. Without this it is a sort over every build ever run.
  @@index([status, completedAt(sort: Desc)], name: "IdeaBuild_status_completedAt_idx")
}

/// Wherever Lex had to choose, the alternative it set aside with the case for it (§4.1).
/// TWO ALTERNATIVES PER FORK, which is why `forkKey` and `alternativeIndex` sit beside
/// the brief's field list: two alternatives are two rows sharing one decision point, and
/// grouping them by `chosen` string equality would be a join on prose.
model BuildFork {
  id                 String    @id @default(uuid())
  buildId            String
  build              IdeaBuild @relation(fields: [buildId], references: [id], onDelete: Cascade)
  ideaId             String
  idea               Idea      @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  forkKey            String
  fieldKey           String
  chosen             String
  alternativeIndex   Int       @default(0)
  alternative        String
  caseForAlternative String
  /// 25-C §3a — WHY Lex chose what it chose. `caseForAlternative` is the case for the road NOT
  /// taken; without this the panel shows the alternative argued for and the recommendation merely
  /// asserted, and a user can only defer to it rather than weigh it.
  /// ⚠ NULL on every build made before 25-C. The agenda renders that absence rather than faking it.
  recommendationReason String?
  /// 25-C turns a fork into a decision. Until then every fork is unresolved, and that is
  /// the honest value rather than a placeholder.
  resolved           Boolean   @default(false)
  /// 25-C §3a — WHICH WAY the user went: `'chosen'` or `'alternative:<n>'`.
  /// ⚠ A string, not a boolean or an index. `resolved` alone records THAT a decision happened and
  /// loses WHAT was decided; a bare index would point at the wrong row if alternatives reorder.
  resolvedChoice     String?
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())

  @@unique([buildId, forkKey, alternativeIndex])
  @@index([buildId])
  @@index([ideaId, fieldKey])
  /// 25-C §3a — the agenda reads a build's decisions, outstanding ones first.
  @@index([ideaId, resolved], name: "BuildFork_ideaId_resolved_idx")
}

enum ElicitationStatus {
  IN_PROGRESS
  AWAITING_CONFIRMATION
  CONFIRMED
}

/// Both values exist from the start even though 25-A only ever writes the first: an enum
/// with one member reads as decoration, and the whole reason this column exists is that
/// the two kinds must be told apart.
enum ElicitationProvenance {
  USER_TESTIMONY
  RETRIEVED
}

enum BuildStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELLED
}

enum BuildFraming {
  /// The user's problem, phrased as they would put it into a chat window.
  A_NAIVE
  /// The problem plus goal, ruled-outs, their own knowledge and the profile.
  B_CONTEXTUALISED
}

/// ─────────────────────────────────────────────────────────────────────────────
/// LlmSpend — BRIEF_SEARCH_S6 §3. Append-only record of every model call, across
/// every stream, attributable to a user and to an idea.
///
/// ⚠ DDL OF RECORD IS `prisma/llm_spend.sql`, applied by `scripts/setup-llm-spend.ts`.
/// This model exists for ONE reason: without it `prisma migrate diff` sees a table it
/// does not know about and proposes DROPPING it. Same pattern as act_metadata.sql and
/// the position-graph tables. Nothing reads this through the typed Prisma client —
/// `lib/lex/spend-ledger.ts` uses $queryRaw and the ingest twin uses pg directly,
/// because it cannot import anything under scrutinise-web/.
///
/// ⚠ estCostPence NULL means UNPRICED, NOT FREE. Anthropic and xAI have no rate on
/// file (docs/MODEL_CONTRACT.md §3), so a pass switched to either records tokens and a
/// null cost, and any total containing one reports null rather than a partial sum.
/// ─────────────────────────────────────────────────────────────────────────────
model LlmSpend {
  id             BigInt   @id @default(autoincrement())
  stream         String
  /// The pass name from lib/lex/model-registry.ts — the join between what was
  /// configured and what it cost.
  pass           String
  model          String
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  /// Billed at the OUTPUT rate, so kept separate rather than folded into input.
  tokensThinking Int      @default(0)
  estCostPence   Decimal? @db.Decimal(12, 4)
  unpriced       Boolean  @default(false)
  /// Nullable: ingest spend belongs to no user and no idea, and is still Charlie's.
  /// ⚠ No relation on purpose — a deleted idea must not delete the record of what it
  /// cost to produce.
  userId         String?
  ideaId         String?
  /// ⚠ Added before the feature that needs it. Buying tokens for a community group is
  /// planned; a column added after there is history leaves every earlier row NULL, and
  /// NULL would then be indistinguishable from "an individual spent this".
  groupId        String?
  ref            String?
  /// ⚠ A failed call still costs money.
  failed         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([ideaId])
  @@index([userId, createdAt])
  @@index([pass, createdAt])
  @@index([stream, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// SPRINT 25-D / 20-E — source exclusion (§2a) and the user's own material (§25.6).
// Hand-written additive schema, applied via prisma/lex_25d.sql. That file carries the
// full reasoning; the notes here are the ones a reader of the schema alone would
// otherwise get wrong.
// ─────────────────────────────────────────────────────────────────────────────

/// §20.2.1 — what the user decided about ONE corpus source. Include, exclude with a
/// reason, or annotate.
///
/// ⚠ A ROW, NOT A FLAG ON THE SOURCE. Corpus sources live in JSON columns written by
/// retrieval, and a decision written there is destroyed the next time the search runs.
/// "Excluded, never deleted" cannot be built on a column a re-run overwrites.
///
/// ⚠⚠ AND THE ROW IS SELF-SUFFICIENT — it carries the source's own title, citation and
/// url. A source excluded today can drop out of retrieval tomorrow; without these the
/// Evidence Pack's "what was considered and set aside" degrades into orphan ids, and
/// the strongest thing this feature does is the first thing to break.
model IdeaSourceDecision {
  id         String               @id @default(uuid())
  ideaId     String
  idea       Idea                 @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  /// The corpus ref id — the same `SearchResult.id` every surface already keys a source by.
  sourceKey  String
  status     SourceDecisionStatus @default(EXCLUDED)
  /// ⚠ Required by the application when status = EXCLUDED. An exclusion with no stated
  /// reason is an unaccountable veto — the rule `DeepeningIssue.dismissReason` is held to.
  reason     String?
  annotation String?
  title      String?
  citation   String?
  url        String?
  sourceType String?
  decidedBy  String
  decidedAt  DateTime             @default(now())
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([ideaId, sourceKey])
  @@index([ideaId, status])
}

/// ⚠ 25-L §3d — THREE STATES, ONE FACT. `PRIORITY` goes in the proposal document,
/// `INCLUDED` in the evidence annex, `EXCLUDED` in the considered-and-set-aside list.
/// A separate boolean would have allowed "excluded AND priority" to exist in the data.
enum SourceDecisionStatus {
  INCLUDED
  EXCLUDED
  PRIORITY
}

/// 25-L §2 — EVERY ITEM WE REFUSED, WITH ITS TYPE.
///
/// ⚠⚠ THIS TABLE IS THE EVIDENCE FOR A DECISION WE HAVE DELIBERATELY NOT TAKEN. §2:
/// "Do not build YouTube transcript fetching now — it is fragile, its terms are unclear,
/// and we have no evidence of demand." A count of the video links people actually tried to
/// give us IS that evidence, and it cannot be recovered later from anywhere else: a
/// rejection that only ever became an error message on a screen leaves no trace at all.
///
/// ⚠ `detail` STORES THE SENTENCE THE USER WAS SHOWN, so the log and the screen cannot
/// drift into disagreeing about what we told them.
model IdeaMaterialRejection {
  id        String   @id @default(uuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  /// Null only where the refusal happened outside a signed-in request.
  userId    String?
  /// video | paywalled | unreadable-format | no-text | too-large | unfetchable | not-a-url | too-many
  kind      String
  /// The URL or the filename — what was refused, so a count can be broken down by host.
  target    String   @db.Text
  detail    String   @db.Text
  createdAt DateTime @default(now())

  @@index([ideaId])
  @@index([kind, createdAt])
}

/// 25-L §5 — A USER'S OWN JUDGEMENT OF A GRAPH CLAIM, MADE BEFORE OURS WAS SHOWN.
///
/// ⚠⚠ THE ORDER IS THE MEASUREMENT. Showing our assessment first buys agreement, not
/// information — so the user's verdict is written on its own, `revealedAt` is stamped when
/// ours is shown, and `agreed` cannot be written before that. Two CHECK constraints enforce
/// it in the database rather than only in the route, because the second writer added in six
/// months will not have read the route.
///
/// ⚠ OUR ASSESSMENT IS COPIED IN AT REVEAL TIME, not joined at read time. The graph decays
/// on every read, so a judgement joined to a live query would be scored against a claim that
/// has since moved; the row has to be able to say what the user was actually shown.
///
/// ⚠ THIS IS CORROBORATION, NOT VERIFICATION. Nothing here overwrites the sourced record.
/// A disagreement raises a flag for review, and a run of agreements is not proof — a
/// partisan sample agrees with itself.
model GraphClaimJudgement {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Null when judged on the standalone review surface rather than inside an idea.
  ideaId               String?
  idea                 Idea?     @relation(fields: [ideaId], references: [id], onDelete: SetNull)

  actorId              String
  actorName            String
  /// The targets the question was asked over, joined — e.g. `division:commons:2051`.
  targetKey            String
  questionText         String    @db.Text

  /// supports | opposes | unclear | not-enough — vocabulary enforced by a CHECK.
  userVerdict          String
  userReason           String?   @db.Text
  /// How many sourced grounds were on screen when they judged. A judgement made over two
  /// votes and one made over forty are not the same evidence.
  groundsShown         Int       @default(0)
  judgedAt             DateTime  @default(now())

  revealedAt           DateTime?
  ourStance            String?
  ourClaim             String?   @db.Text
  ourConfidence        Float?
  ourConfidenceWording String?
  configVersion        String?

  agreed               Boolean?
  agreedReason         String?   @db.Text
  answeredAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([actorId])
  @@index([userId])
  @@index([agreed])
}

/// ══ SURFACE 3 §4 — A USER'S VERDICT ON A DONATION-DERIVED ALIGNMENT ═══════════════════════
///
/// ⚠⚠ A VERDICT IS A SIGNAL, NOT A TRUTH, AND THIS TABLE IS WHY THAT IS STRUCTURAL RATHER THAN
/// A PROMISE. §4: *"Store verdicts as observations with who, when, and the config version. One
/// verdict must not overwrite an estimate."*
///
/// Nothing anywhere writes back from here into `position_signal` or `position_estimate`. The
/// alignment on screen is recomputed from the Electoral Commission register on every read; a
/// disagreement raises a flag for a human to look at and changes no number. That is the same
/// rule `GraphClaimJudgement` follows for positions, and for the same reason: a partisan sample
/// agrees with itself, and an agreement rate that had silently tuned the thing it measures is
/// worthless as a measurement.
///
/// ⚠ HOW MANY VERDICTS SHOULD MOVE AN ESTIMATE, AND IN WHAT DIRECTION, IS DELIBERATELY NOT
/// DECIDED HERE. It is Charlie's decision and the options are set out in
/// `docs/SURFACE_3_REPORT.md`. Storing the observations first is what makes any of those options
/// available later; deciding now would have picked one before there was a single row to reason
/// about.
///
/// ⚠ THE ORDER IS THE MEASUREMENT, exactly as it is for positions. `userVerdict` is recorded
/// BEFORE `ourTier` is revealed, and `revealedAt` is stamped in the same write, so a row cannot
/// claim a blind judgement it did not collect.
model GraphDonationJudgement {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Null when judged on the standalone review surface rather than inside an idea.
  ideaId        String?
  idea          Idea?     @relation(fields: [ideaId], references: [id], onDelete: SetNull)

  /// `graph_entity.id` of the donor organisation. Text, because that table is outside Prisma.
  donorEntityId String
  donorName     String
  /// The parties given to, as published, joined — the FACT the user judged.
  partiesShown  String    @db.Text
  /// How many published donations were on screen. Two records and forty are not the same evidence.
  factsShown    Int       @default(0)

  /// sympathetic | not-sympathetic | no-direction | not-enough — their reading of the record alone.
  userVerdict   String
  userReason    String?   @db.Text
  judgedAt      DateTime  @default(now())

  revealedAt    DateTime?
  /// sustained-single-party | one-off-single-party | multi-party
  ourTier       String?
  ourInference  String?   @db.Text
  ourConfidence String?
  configVersion String?

  /// ⚠ THREE-WAY, NOT A BOOLEAN. right | wrong | not-sure. "Not sure" is the answer a careful
  /// person gives to a thin record, and collapsing it into "wrong" would make the agreement rate
  /// a measure of how decisive our users are.
  agreed        String?
  agreedReason  String?   @db.Text
  answeredAt    DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([donorEntityId])
  @@index([userId])
  @@index([agreed])
}

/// ══ 25-N §3e — A TICK ON THE WORKLIST ═════════════════════════════════════════════
///
/// §3e makes the worklist four parts, *"each a checkbox list"*, with **Things to read**
/// *"each tickable as read"*. A tick is a fact about ONE PERSON's progress through the work,
/// not about the idea — two collaborators reading the same evidence have read different
/// halves of it — so it is keyed on the user, exactly as `IdeaNote` is.
///
/// ⚠ `itemKey` IS THE THING'S OWN ID, NOT A ROW NUMBER. The worklist is assembled from the
/// agenda on every load and its ORDER changes as work is done; ticking "item 3" would move the
/// tick onto whatever landed third next time. What is stored is `read:<evidenceId>` or
/// `decision:<forkKey>` — the identity of the thing, so a tick survives a re-run.
///
/// ⚠ AND AN UNTICKED ITEM IS AN ABSENT ROW, not a `false`. There is nothing to migrate when a
/// build adds forty findings, and "not yet read" needs no write.
model IdeaWorklistTick {
  id        String   @id @default(uuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// `read:<id>` | `decision:<forkKey>` | `scrutiny:<action>` | `promote:<action>`.
  itemKey   String
  createdAt DateTime @default(now())

  @@unique([ideaId, userId, itemKey])
  @@index([ideaId, userId])
}

/// ══ 25-N §3c — THE USER'S OWN NOTES, PRIVATE TO THEM ══════════════════════════════
///
/// §3c: *"Notes — private to the user, saved with the idea, **never shared**. Notes can be
/// titled, dragged under headings and sorted, each with show/hide."*
///
/// ⚠⚠ PRIVACY IS ENFORCED BY THE KEY, NOT BY A FLAG. There is no `visibility` column and
/// there must not be one: a boolean that defaults to private is a boolean somebody will set
/// the other way, and every read is then one missing `where` clause from leaking a user's
/// working notes to their idea-team. `(ideaId, userId)` is the only way in, so a note is
/// unreachable to anyone but its author by construction rather than by discipline.
///
/// ⚠ AND THAT IS WHY CHARLIE'S OPEN QUESTION — should notes be visible to the idea-team? —
/// is RECORDED AND NOT RESOLVED here (§3c, and the report sets out the options). Building the
/// sharing switch now would mean shipping the flag this comment argues against, before the
/// decision that would justify it.
///
/// ⚠ `source` DISTINGUISHES THE ONE NOTE NOBODY WROTE. §3c moves the user's original idea
/// here, under "My original idea" — it is theirs, it is a note, and it should not be the first
/// thing on the working page. It is seeded rather than authored, so it is marked, and the
/// seeding is idempotent on `(ideaId, userId, source)`.
///
/// Deleted with the idea (GDPR erasure): cascade, never a soft delete.
/// ══ 25-Q §1d — WHAT WAS THERE BEFORE A CHAT REWRITE REPLACED IT ══════════════════════
///
/// §1d is a standing principle, not a feature of this sprint: *"the user's own words are
/// testimony, kept verbatim and attributed, never overwritten by an edited version. An accepted
/// rewrite supersedes; it does not delete."*
///
/// ⚠⚠ A TABLE RATHER THAN A `priorText` COLUMN, and the reason is the second rewrite. A column
/// holds one previous version and silently loses the one before it — so the principle would hold
/// for exactly one edit and then quietly stop, which is worse than not claiming it.
///
/// ⚠ IT RECORDS WHO WROTE THE TEXT THAT WAS SUPERSEDED, not only who accepted the replacement.
/// "Lex's earlier draft was replaced" and "the user's own words were replaced" are different
/// facts, and only the second is testimony. Without `previousSource` they are the same row.
model FieldRevision {
  id             String   @id @default(uuid())
  ideaId         String
  idea           Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  /// The field the user knows it by — `policyOptions`, `challenge`, `leverage`…
  fieldKey       String
  /// The child row, where the field's content lives in one. Null for a whole-field edit.
  targetId       String?
  /// The stable number the user read off the screen when they accepted. 25-Q §1.
  targetNumber   Int?

  previousText   String   @db.Text
  /// USER or LEX — who wrote the text that has just been superseded.
  previousSource String
  newText        String   @db.Text

  acceptedById   String
  acceptedBy     User     @relation("FieldRevisionAcceptor", fields: [acceptedById], references: [id])
  /// How the replacement arrived. CHAT_REWRITE today; a later surface adds its own name.
  origin         String   @default("CHAT_REWRITE")

  createdAt      DateTime @default(now())

  @@index([ideaId, fieldKey])
  @@index([ideaId, targetId])
}

model IdeaNote {
  id        String   @id @default(uuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  /// ⚠ THE AUTHOR, AND THE ONLY READER. See the header.
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// §3c — "Notes can be titled". Empty is allowed: a note the user has not named yet is a
  /// note, and forcing a title before they may write is a form standing in front of a thought.
  title     String   @default("")
  body      String   @db.Text

  /// §3c — "dragged under headings". A free-text group name, not an enum: the user's filing
  /// system is theirs, and a closed set would be ours. Empty means ungrouped.
  heading   String   @default("")
  /// §3c — "and sorted". Explicit, so a reorder is a stored fact rather than a re-derivation.
  position  Int      @default(0)
  /// §3c — "each with show/hide". Collapsed in the panel; NOT deleted, and not private-er.
  hidden    Boolean  @default(false)

  /// `USER` for anything typed here; `ORIGINAL_IDEA` for the seeded one. See the header.
  source    String   @default("USER")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The only index that matters: every read is scoped to one user on one idea, in order.
  @@index([ideaId, userId, position])
  /// ⚠⚠ ONE SEEDED ORIGINAL-IDEA NOTE PER USER PER IDEA — AND IT IS A **PARTIAL** UNIQUE
  /// INDEX, WHICH IS WHY IT IS NOT DECLARED HERE.
  ///
  /// The obvious `@@unique([ideaId, userId, source])` is WRONG, and wrong in the direction
  /// that breaks the feature: it would also apply to `source = 'USER'`, so a user could have
  /// exactly one note. The constraint that is actually wanted is
  /// `UNIQUE (ideaId, userId, source) WHERE source <> 'USER'` — seeded notes are unique, typed
  /// notes are not — and `schema.prisma` cannot express a partial index at all.
  ///
  /// It lives in `prisma/lex_25n_notes.sql` and is on the CLAUDE.md §21 hazard register.
  /// ⚠ `prisma migrate diff` WILL PROPOSE DROPPING IT, because to Prisma it is drift. Accept
  /// that diff and nothing breaks visibly — the guard is simply gone, and the first evidence
  /// is a user with their original idea written out twice.
}

/// §25.6 — a document or a link the user brought, held as EXTRACTED TEXT and nothing else.
///
/// ⚠ NO BINARY IS STORED. ~30KB a document means storage is free at any plausible scale;
/// a stored PDF is a liability to hold, serve and erase, and it invites someone to hand
/// the whole thing to a model later. Which is the second rule: the text is NEVER injected
/// wholesale into a prompt — it is read once into findings with provenance, and those
/// findings are what retrieval surfaces.
///
/// Deleted with the idea (GDPR erasure): cascade, never a soft delete.
model IdeaUserMaterial {
  id            String             @id @default(uuid())
  ideaId        String
  idea          Idea               @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  kind          UserMaterialKind
  status        UserMaterialStatus @default(PENDING)
  label         String
  filename      String?
  mimeType      String?
  /// ⚠ RETAINED FOR A LINK, ALWAYS. A quotation whose source cannot be reopened is not
  /// evidence.
  url           String?
  /// The extracted text — THE ONLY COPY OF THE CONTENT WE HOLD.
  text          String?
  charCount     Int                @default(0)
  sourceBytes   Int                @default(0)
  /// Set on FAILED. An empty entry and a failed extraction must not look the same.
  failureReason String?
  /// When the findings pass last read it. NULL means the text is stored and has never
  /// been read — a state the UI states rather than hides.
  findingsAt    DateTime?
  findingCount  Int                @default(0)
  /// The user's assertion that they may share it (§25.6 liability).
  rightsConfirmed Boolean          @default(false)
  addedBy       String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([ideaId])
  @@index([ideaId, status])
}

enum UserMaterialKind {
  FILE
  LINK
}

enum UserMaterialStatus {
  PENDING
  READY
  FAILED
}

/// CENTRAL item 12 — what "approved" means in ONE Community. Root only.
/// Generic platform machinery: nothing party-specific is hard-coded, every
/// Community sets its own values, and Reform UK's are a seeded ROW.
model CommunitySettings {
  id                     String    @id @default(uuid())
  communityId            String    @unique
  community              Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  /// Shown wherever the approval label appears.
  organisationName       String?
  /// Hex, for the approval frame.
  /// ⚠ #17B9D1 against the platform's live-state teal #14b8a6 is ΔE2000 15.14 —
  /// plainly different side by side, but both read as "teal" at the size a
  /// border and a superscript render. The frame is therefore distinguished by
  /// BORDER WEIGHT and LABEL, with colour as reinforcement only: a party stamp
  /// must not read as a platform state.
  organisationColour     String?
  /// Hidden removes the name, the colour frame and the superscript entirely.
  /// ⚠ It does NOT delete approval data — re-enabling restores it, so turning
  /// the feature off is never a destructive act.
  approvalFeatureEnabled Boolean   @default(true)
  /// SELF | BRANCH_ADMIN | COMMUNITY_ADMIN | NAMED
  approvalMode           String    @default("SELF")
  /// CENTRAL 25-A 3a - which roles BESIDES THE OWNER may invite people to this
  /// Community and approve the people who arrive through a link. Root only, set
  /// by the owner. Values: COMMUNITY_ADMIN, BRANCH_MANAGER (lib/invite-rights.ts).
  ///
  /// The OWNER always holds the right and is deliberately not listable here: a
  /// setting that can remove the owner's own right is a setting that can lock a
  /// Community out of inviting anybody.
  ///
  /// Default is BOTH, which is exactly what every Community could do before this
  /// setting existed - so adding it changes nothing until an owner narrows it.
  inviteRights           String[]  @default(["COMMUNITY_ADMIN", "BRANCH_MANAGER"])
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

/// CENTRAL 25-A 3c - a membership that has been ended, kept.
///
/// Removing somebody from a team deletes their CommunityMember row, and before
/// this that was the whole of the record: no trace that they had ever been a
/// member, who removed them, or when. Their CONTRIBUTIONS were never touched and
/// still are not - bulletin posts, questions, answers and ideas stay exactly
/// where they are, attributed to them, because a removed member's own writing is
/// still theirs.
///
/// A SEPARATE TABLE, not a `removedAt` column on CommunityMember, for two
/// reasons that both bite in production:
///   1. `CommunityMember` carries @@unique([communityId, userId]), so an archived
///      row left in place would make re-joining impossible.
///   2. Dozens of queries read CommunityMember as "the members". A soft-delete
///      column means every one of them needs a filter, and the one that gets
///      missed silently treats a removed person as a member.
model CommunityMembershipArchive {
  id              String              @id @default(uuid())
  communityId     String
  community       Community           @relation(fields: [communityId], references: [id])
  userId          String
  user            User                @relation("ArchivedMembership", fields: [userId], references: [id])
  /// The role they held when they were removed.
  role            CommunityMemberRole
  joinedAt        DateTime
  removedAt       DateTime            @default(now())
  removedByUserId String?
  removedBy       User?               @relation("MembershipRemover", fields: [removedByUserId], references: [id])
  reason          String?
  /// CENTRAL 25-A §7h — carried across from the membership, so removing
  /// somebody never destroys the record of who brought them in.
  invitedByUserId String?
  invitedByArchived User?             @relation("ArchivedMembershipInviter", fields: [invitedByUserId], references: [id])
  invitedViaInviteId String?
  /// Carried across from the membership — see CommunityMember.acceptedOnBehalfAt.
  acceptedOnBehalfAt DateTime?
  /// CENTRAL 25-C §1a — what they were when they were removed. Re-deriving a
  /// tier after the live row has gone is not possible, so it is carried.
  tier            CommunityMembershipTier @default(GROUP)

  @@index([communityId])
  @@index([userId])
}

/// CENTRAL 25-C §2i — a branch manager resigns and nominates a replacement,
/// subject to admin approval.
///
/// ⚠⚠ A PENDING ROW CONFERS NOTHING. It is a record of an ask and nothing else:
/// no `CommunityMember.role` moves until a community admin approves, and the
/// transfer is then done by `appointBranchOwner` — still the only function
/// outside creation that writes an OWNER row, still guarded, still logging.
/// `check:central-25c` asserts BOTH directions, because "the nomination did
/// nothing" and "the approval did everything" are two different bugs.
///
/// ⚠ A DECLINED row is kept. "The branch asked for X and the Community said no"
/// is exactly the kind of fact that later reads as a bug if it is not recorded
/// — the same reasoning as decision 51's required vacate reason.
model BranchOwnerNomination {
  id                String    @id @default(uuid())
  communityId       String
  community         Community @relation(fields: [communityId], references: [id])
  /// The outgoing manager who made the nomination. They may already have stood
  /// down by the time it is decided (§2f) — the nomination outlives the role.
  nominatedByUserId String
  nominatedBy       User      @relation("BranchNominator", fields: [nominatedByUserId], references: [id])
  nomineeUserId     String
  nominee           User      @relation("BranchNominee", fields: [nomineeUserId], references: [id])
  /// Required, for decision 51's reason: an unexplained change of chair later
  /// reads as a fault rather than a decision.
  reason            String
  status            BranchNominationStatus @default(PENDING)
  createdAt         DateTime  @default(now())
  decidedAt         DateTime?
  decidedByUserId   String?
  decidedBy         User?     @relation("BranchNominationDecider", fields: [decidedByUserId], references: [id])
  decisionNote      String?

  @@index([communityId, status])
  @@index([nomineeUserId])
}

/// The NAMED approval mode's picker.
model CommunityApprover {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("CommunityApprover", fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([communityId, userId])
}

/// CENTRAL Stage 2g — a shared asset: a graphic, a flyer, a template, a link.
///
/// ⚠ EITHER a file OR a link. Video and websites are links only — no hosting,
/// per the standing decision — so `fileKey` stays null for those.
///
/// ⚠ THIS TABLE CARRIES A PARTIAL INDEX PRISMA CANNOT SEE: `Resource_live_idx`
/// on ("communityId", "createdAt") WHERE "deletedAt" IS NULL, created in
/// `prisma/central_2g_resources.sql`. `prisma migrate diff` will propose
/// DROPPING it and say nothing when it does. See docs/CLAUDE.md §21.
model Resource {
  id          String    @id @default(uuid())
  /// The ROOT Community, as everything else in Central is scoped.
  communityId String
  community   Community @relation("ResourceCommunity", fields: [communityId], references: [id])
  branchId    String?
  branch      Community? @relation("ResourceBranch", fields: [branchId], references: [id])
  authorId    String
  author      User      @relation("ResourceAuthor", fields: [authorId], references: [id])
  /// MEME | FLYER | SOCIAL | VIDEO | TRAINING | EVENT_PACK | WEBSITE | MERCH | TEMPLATE
  type        String
  title       String
  /// REQUIRED. The poster's note on why it is worth using — it is what makes the
  /// tab worth browsing rather than a file dump.
  whyUseful   String
  /// Item 13. Free text, PERMANENT, never hidden by the approval toggle.
  context     String?
  topicTags   String[]  @default([])
  /// R2 object key. The bucket stays private; the app serves a signed URL.
  fileKey     String?
  fileName    String?
  fileType    String?
  fileSize    Int?
  externalUrl String?
  /// COMMUNITY | BRANCH
  scope       String    @default("COMMUNITY")
  /// ⚠ THE COPYRIGHT ASSERTION, RECORDED AGAINST THE ROW rather than being a
  /// checkbox that vanishes on submit. Who said they had the right to share
  /// this, and when.
  rightsConfirmedByUserId String
  rightsConfirmedBy       User   @relation("ResourceRightsConfirmer", fields: [rightsConfirmedByUserId], references: [id])
  rightsConfirmedAt       DateTime @default(now())
  /// Item 13 — who asserted the approval, always displayed by name.
  approvedByUserId String?
  approvedBy       User?    @relation("ResourceApprover", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  /// MEMBER | AI. An AI-authored resource ranks and mints nothing, as answers do.
  authorType  String    @default("MEMBER")
  aiModel     String?
  /// The 2f content soft-delete pattern, unchanged.
  deletedAt         DateTime?
  deletedByUserId   String?
  deletedBy         User?    @relation("ResourceDeleter", fields: [deletedByUserId], references: [id])
  deletionReason    String?
  deletedWithParent Boolean  @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  votes   ResourceVote[]
  flags   ResourceFlag[]
  reports ResourceReport[]

  @@index([communityId, type])
  @@index([authorId])
}

model ResourceVote {
  id         String   @id @default(uuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("ResourceVoter", fields: [userId], references: [id], onDelete: Cascade)
  /// UP | DOWN
  direction  String
  voteWeight Float    @default(1.0)
  createdAt  DateTime @default(now())

  @@unique([resourceId, userId])
}

/// The existing Do not use / Use with care levels, unchanged, reason required.
model ResourceFlag {
  id          String   @id @default(uuid())
  resourceId  String   @unique
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  /// DO_NOT_USE | USE_WITH_CARE
  level       String
  reason      String
  setByUserId String
  setBy       User     @relation("ResourceFlagger", fields: [setByUserId], references: [id])
  setAt       DateTime @default(now())
}

/// A visible Report action on every resource, routing to Community admins.
model ResourceReport {
  id               String    @id @default(uuid())
  resourceId       String
  resource         Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  reportedByUserId String
  reportedBy       User      @relation("ResourceReporter", fields: [reportedByUserId], references: [id], onDelete: Cascade)
  reason           String
  /// OPEN | RESOLVED
  status           String    @default("OPEN")
  resolvedByUserId String?
  resolvedBy       User?     @relation("ResourceReportResolver", fields: [resolvedByUserId], references: [id])
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([resourceId, status])
}
