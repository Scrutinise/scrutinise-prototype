model User {
  id                        String              @id @default(uuid())
  clerkId                   String              @unique
  /// 25-N §3c — this user's private working notes, across every idea. Never read by anyone else.
  ideaNotes                 IdeaNote[]
  fieldRevisions            FieldRevision[] @relation("FieldRevisionAcceptor")
  /// 25-N §3e — this user's worklist ticks.
  worklistTicks             IdeaWorklistTick[]
  /// ══ 25-M §4 — THE PILOT ALLOWANCE, IN THIRDS OF A BUILD ══════════════════
  ///
  /// A full build costs 3, a reuse re-run costs 1 (25-K §6: "re-runs counted in thirds,
  /// because they reuse the research"). ⚠ An INTEGER, not a float: this number decides
  /// whether somebody may press a button, and "0.30000000000000004 of a build left" is not
  /// a state anybody should have to reason about.
  ///
  /// Default 4 = one free build plus one re-run. §4 says one free build; a user whose single
  /// build comes back wrong and who cannot redraft it has not really had one.
  ///
  /// ⚠⚠ THE COUNTER IS `IdeaBuild`, NOT `LlmSpend`. §4 assumed LlmSpend carried the user —
  /// measured on 28 Aug it holds 2,702 rows of which **2** have a userId, and every
  /// build-stream row sampled had none. An allowance counted there would read zero for
  /// everybody. See `lib/lex/allowance.ts`.
  buildAllowanceThirds      Int                 @default(4)
  /// Who granted or changed the allowance, and why. An allowance that moves with no record
  /// of who moved it is an unaccountable grant.
  buildAllowanceNote        String?

  /// 25-L §4 — which Lex panels are open and how wide, per user.
  ///
  /// ⚠ A COLUMN, NOT `localStorage`. §4 says the choice persists PER USER; a browser store
  /// persists per DEVICE, so a layout set on a laptop is gone on a desktop and reads as
  /// having failed to save. Validated by Zod on write; loose here so a fourth panel needs
  /// no migration.
  lexPanelLayout            Json?
  // Identity
  firstName                 String
  lastName                  String
  name                      String              // Full name — denormalised
  preferredName             String?             // How would you like Lex to address you? Defaults to firstName
  displayName               String?             // @handle display, defaults to "Boss" until set
  username                  String              @unique
  email                     String              @unique
  emailVerified             Boolean             @default(false)
  /// AMENDMENT_25B §C4 — the user's remembered default for "email me when the build is
  /// done". A PREFERENCE, not a consent record: `EmailSuppression` remains the authority
  /// on whether we may email the address at all, and the send path checks it.
  ///
  /// ⚠ 25-W §B — THE DEFAULT IS NOW `true`, AND THE REASON IS ARCHITECTURAL, NOT COSMETIC.
  /// It was `false` while a build was driven by the user's browser tab: offering to email
  /// someone when their build finished was inviting them to close the laptop, and closing
  /// the laptop stopped the build. 25-T moved builds onto the Railway worker and 25-V §1d
  /// confirmed one completing with the tab shut, so the promise is now one the architecture
  /// keeps, and a ten-minute job should not need anybody to sit and watch it.
  /// See `prisma/lex_25w.sql` for the guarded backfill of rows that never made a choice.
  emailOnBuildComplete      Boolean             @default(true)
  bio                       String?
  /// CENTRAL Stage 2d — optional, entered by the user in their own settings and
  /// used for NOTHING except training contact sharing on an accepted
  /// TrainingMatch. Never rendered in member lists, search, exports, packs or
  /// admin panels; check:central asserts that.
  phone                     String?
  /// CENTRAL Stage 2h item 7 — the PALETTE KEY of this member's chosen platform
  /// accent (see lib/accent.ts), or null for the platform default.
  /// ⚠ A key, deliberately not a hex value: a hex column is a free-hex feature
  /// with extra steps, and free hex is what produces unreadable and
  /// non-compliant colour combinations.
  accentColour              String?
  // Role
  role                      UserRole            @default(CITIZEN)
  // Status
  status                    UserStatus          @default(ACTIVE)
  // Consent (Sprint 1)
  ageConfirmed              Boolean             @default(false)
  tcAgreedAt                DateTime?
  rulesAgreedAt             DateTime?
  tcVersion                 String?
  // Parliamentary / professional
  parliamentaryStatus       ParliamentaryStatus @default(NONE)
  parliamentaryVerified     Boolean             @default(false)
  professionalVerified      Boolean             @default(false)
  expertType                String?
  // Political spectrum (store only — UI deferred)
  politicalSpectrumX        Decimal?
  politicalSpectrumY        Decimal?
  // AI
  aiCreditBalance           Decimal             @default(0)
  aiUsageTotal              Decimal             @default(0)
  aiPreferredStyle          String?             // COLLABORATIVE | SOCRATIC | DIRECT — default COLLABORATIVE
  experienceLevel           ExperienceLevelEnum?
  // Lex rebuild (Page 1, Box 3 "About you") — profile, reused across every idea the user creates
  aboutYouNarrative         String?             // raw Box 3 free text
  profileSlots              Json?               // { career, resources, legislativeKnowledge, politicalLevel, whatTheyWant }
  // Historical / seed accounts
  isHistoricalAccount       Boolean             @default(false)
  // Credibility override (admin only)
  manualCredibilityOverride Decimal?
  // Referral
  referralCode              String              @unique
  referredByUserId          String?
  referredBy                User?               @relation("Referrals", fields: [referredByUserId], references: [id])
  referredUsers             User[]              @relation("Referrals")
  // GDPR / account deletion
  deletionRequestedAt       DateTime?
  deletionScheduledFor      DateTime?
  unsubscribeToken          String              @unique @default(uuid())
  // Meta
  country                   String?             @default("GB")
  joinDate                  DateTime            @default(now())
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  lastActiveAt              DateTime?

  // Relations
  ideas                     Idea[]              @relation("IdeaCreator")
  votes                     Vote[]
  comments                  Comment[]
  commentRatings            CommentRating[]
  endorsements              Endorsement[]
  draftsmanEndorsements     DraftsmanEndorsement[]
  notifications             Notification[]
  activityLogs              ActivityLog[]
  adminActivityLogs         ActivityLog[]       @relation("AdminAccessLogs")
  credibilityScore          CredibilityScore?
  ideaCollaborators         IdeaCollaborator[]
  sentInvites               UserInvite[]        @relation("SentInvites")
  groupMemberships          GroupMember[]
  ownedGroups               Group[]
  communityMemberships      CommunityMember[]
  /// CENTRAL 25-A §7h — the people this user brought into a Community.
  membershipsInvited        CommunityMember[]   @relation("MembershipInviter")
  membershipsInvitedArchived CommunityMembershipArchive[] @relation("ArchivedMembershipInviter")
  /// CENTRAL 25-A 3c - memberships of this user that were ended, kept.
  archivedMemberships       CommunityMembershipArchive[] @relation("ArchivedMembership")
  membershipsRemoved        CommunityMembershipArchive[] @relation("MembershipRemover")
  communityJoinRequests     CommunityJoinRequest[] @relation("JoinRequester")
  communityJoinDecisions    CommunityJoinRequest[] @relation("JoinDecider")
  /// CENTRAL 25-C §2i — resign-and-nominate, from all three sides.
  branchNominationsMade     BranchOwnerNomination[] @relation("BranchNominator")
  branchNominationsReceived BranchOwnerNomination[] @relation("BranchNominee")
  branchNominationsDecided  BranchOwnerNomination[] @relation("BranchNominationDecider")
  managedCommunities        Community[]         @relation("CommunityManager")
  centralPointsEvents       PointsEvent[]       @relation("CentralPointsEarner")
  centralPointsCaused       PointsEvent[]       @relation("CentralPointsActor")
  centralReferralsMade      CommunityReferral[] @relation("CentralReferralInviter")
  centralReferralsReceived  CommunityReferral[] @relation("CentralReferralInvitee")
  centralActivityClaims     ActivityClaim[]     @relation("CentralClaimant")
  centralClaimDecisions     ActivityClaim[]     @relation("CentralClaimDecider")
  centralClaimReversals     ActivityClaim[]     @relation("CentralClaimReverser")
  questionsAsked            Question[]          @relation("QuestionAuthor")
  questionsDeleted          Question[]          @relation("QuestionDeleter")
  answersApproved           Answer[]            @relation("AnswerApprover")
  communityApproverFor      CommunityApprover[] @relation("CommunityApprover")
  resourcesAuthored         Resource[]          @relation("ResourceAuthor")
  resourcesRightsConfirmed  Resource[]          @relation("ResourceRightsConfirmer")
  resourcesApproved         Resource[]          @relation("ResourceApprover")
  resourcesDeleted          Resource[]          @relation("ResourceDeleter")
  resourceVotes             ResourceVote[]      @relation("ResourceVoter")
  resourceFlagsSet          ResourceFlag[]      @relation("ResourceFlagger")
  resourceReports           ResourceReport[]    @relation("ResourceReporter")
  resourceReportsResolved   ResourceReport[]    @relation("ResourceReportResolver")
  communitiesDeleted        Community[]         @relation("CommunityDeleter")
  answersDeleted            Answer[]            @relation("AnswerDeleter")
  bulletinPostsDeleted      BulletinPost[]      @relation("BulletinPostDeleter")
  questionVotes             QuestionVote[]      @relation("QuestionVoter")
  answersGiven              Answer[]            @relation("AnswerAuthor")
  answerVotes               AnswerVote[]        @relation("AnswerVoter")
  answerFavourites          AnswerFavourite[]   @relation("AnswerFavouriter")
  answerFlagsSet            AnswerFlag[]        @relation("AnswerFlagger")
  editSuggestions           EditSuggestion[]    @relation("EditSuggester")
  questionPacks             Pack[]              @relation("PackOwner")
  trainingListings          TrainingListing[]   @relation("TrainingListingAuthor")
  trainingProposals         TrainingMatch[]     @relation("TrainingResponder")
  trainingMatchesClosed     TrainingMatch[]     @relation("TrainingMatchCloser")
  trainingGiven             TrainingSession[]   @relation("TrainingTrainer")
  trainingReceived          TrainingSession[]   @relation("TrainingTrainee")
  trainingSessionsLogged    TrainingSession[]   @relation("TrainingSessionLogger")
  bulletinPosts             BulletinPost[]
  bulletinVotes             BulletinVote[]
  partyMemberships          PartyMembership[]
  platformConfigUpdates     PlatformConfig[]
  ideaReviews               IdeaReview[]
  ideaAlerts                IdeaAlert[]
  parliamentaryVerifications UserParliamentaryVerification[]
  professionalVerifications  UserProfessionalVerification[]
  aiUsageLogs               AIUsageLog[]
  attachments               Attachment[]
  wordingHistories          WordingHistory[]
  stageTransitions          StageTransition[]
  contentReports            ContentReport[]     @relation("ReportedBy")
  contentReviewedBy         ContentReport[]     @relation("ReviewedBy")
  disputedLogicFlags        DisputedLogicFlag[]
  researchContributions     Research[]
  authoredAmendments        Amendment[]
  lexInsightReviews         LexInsight[]
  reputation                Reputation?
  pointsLedger              PointsLedger[]
  pointsRelatedTo           PointsLedger[]   @relation("PointsRelatedUser")
  referralsMade             ReferralEvent[]  @relation("ReferrerUser")
  referralsReceived         ReferralEvent[]  @relation("ReferredUser")
  legislationCorrections    LegislationCorrection[]
  feedbacks                 Feedback[]
  lexFeedbackItems          FeedbackItem[]
  /// 25-L §5 — this user's blind-first judgements of graph claims.
  graphJudgements           GraphClaimJudgement[]
  graphDonationJudgements   GraphDonationJudgement[]
  proposalVersions          ProposalVersion[]   @relation("ProposalVersionCreator")

  @@index([clerkId])
  @@index([email])
  @@index([username])
}

model PartyMembership {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  partyName        String
  membershipNumber String?
  memberSince      DateTime?
  isPrimary        Boolean   @default(false)
  createdAt        DateTime  @default(now())

  @@index([userId])
}

