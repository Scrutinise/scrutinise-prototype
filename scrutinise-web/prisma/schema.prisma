// ─────────────────────────────────────────────────────────────────────────────
// SECTION 5B — COMMUNITY
// Entirely separate from the Group/GroupMember/GroupInvite models above, which
// remain the Idea-scoped "Team" mechanism and are unchanged by this section.
// Community is a larger, persistent, cross-Idea entity with its own hierarchy
// (branches/sub-teams via parentCommunityId, mirroring RootCause.parentId /
// DiagnosisCause.parentCauseId). Idea.communityId (see SECTION 1) links an Idea
// to its originating Community for display only — it grants no permissions.
//
// ⚠ THIS TABLE CARRIES A PARTIAL INDEX PRISMA CANNOT SEE:
// `Community_live_children_idx` on ("parentCommunityId") WHERE "deletedAt" IS
// NULL, created in `prisma/central_branch_delete.sql` for item 11.
// `prisma migrate diff` will propose DROPPING it and say nothing when it does.
// See docs/CLAUDE.md §21.
// ─────────────────────────────────────────────────────────────────────────────

model Community {
  id                String    @id @default(uuid())
  name              String
  description       String?
  // Self-referential hierarchy for branches/sub-teams — null = top-level Community.
  parentCommunityId String?
  parent            Community?  @relation("CommunityHierarchy", fields: [parentCommunityId], references: [id])
  children          Community[] @relation("CommunityHierarchy")
  // Assigned branch/node manager (Stage 1 "Teams & branches" — admin can assign
  // a manager per node). Informational/authorization hint only, not itself a
  // permission grant — the manager must also hold an OWNER/ADMIN CommunityMember
  // row on this node for the app layer to actually treat them as an admin here.
  managerId         String?
  manager           User?       @relation("CommunityManager", fields: [managerId], references: [id])
  // Bulletin-board category set for this Community, in display order. Seeded
  // from DEFAULT_BULLETIN_CATEGORIES (lib/community.ts) at creation; there is
  // deliberately NO admin category-management UI at Stage 1.1 — defaults only.
  // Stored per-Community rather than hardcoded so that UI can be added later
  // without a second migration.
  bulletinCategories String[] @default([])
  /// CENTRAL item 11 (27 Aug 2026) — branch soft-delete, same shape as the content
  /// pattern. ⚠ No `deletedWithParent`: deleting a parent that still has children is
  /// REFUSED, so a Community row is never collateral and the column would imply a
  /// cascade that cannot happen.
  deletedAt         DateTime?
  deletedByUserId   String?
  deletedBy         User?     @relation("CommunityDeleter", fields: [deletedByUserId], references: [id])
  deletionReason    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  members           CommunityMember[]
  titles            CommunityTitle[]
  archivedMembers   CommunityMembershipArchive[]
  branchNominations BranchOwnerNomination[]
  invites           CommunityInvite[]
  joinRequests      CommunityJoinRequest[]
  bulletinPosts     BulletinPost[]
  pointsEvents      PointsEvent[]       @relation("CentralPointsCommunity")
  sourcedPointsEvents PointsEvent[]     @relation("CentralPointsSourceCommunity")
  referrals         CommunityReferral[]
  activityClaims    ActivityClaim[]
  questions         Question[]          @relation("QuestionCommunity")
  branchQuestions   Question[]          @relation("QuestionBranch")
  questionPacks     Pack[]              @relation("PackCommunity")
  questionTags      QuestionTag[]       @relation("QuestionTagCommunity")
  trainingListings  TrainingListing[]   @relation("TrainingListingCommunity")
  trainingSessions  TrainingSession[]   @relation("TrainingSessionCommunity")
  settings          CommunitySettings?
  approvers         CommunityApprover[]
  resources         Resource[]          @relation("ResourceCommunity")
  branchResources   Resource[]          @relation("ResourceBranch")
  // Ideas that originated in this Community — informational/display only, see note above.
  ideas             Idea[]

  @@index([parentCommunityId])
  @@index([managerId])
}

model CommunityMember {
  id          String              @id @default(uuid())
  communityId String
  community   Community           @relation(fields: [communityId], references: [id])
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  role        CommunityMemberRole @default(MEMBER)
  joinedAt    DateTime            @default(now())
  /// ══ CENTRAL 25-C §1a — GROUP OR BRANCH ════════════════════════════════════
  ///
  /// ⚠⚠ READ FROM THE ROOT ROW, ALWAYS. The tier that decides anything is the
  /// one on the person's membership of the ROOT Community; `rootTierFor()` in
  /// lib/membership-tier.ts is the only thing that should read this column, and
  /// every gate goes through it. It is stored on branch rows too, mirroring the
  /// root row so that a human reading the table is never shown two answers, and
  /// `setMembershipTier` updates every row in one transaction to keep it so.
  ///
  /// ⚠ THE ROOT ROW IS STILL CREATED FOR A BRANCH JOIN and is not deletable —
  /// twelve gates and `check:central`'s branch-implies-root invariant depend on
  /// it. Only two rights detach: `canCreateBranchUnder` and `inviteRightFor`.
  ///
  /// ⚠ The DEFAULT is GROUP because it is the compatible value for a write that
  /// forgets to set it, not because it is the right answer for an existing row.
  /// The six live rows were tiered by DERIVATION (§1f,
  /// scripts/backfill-membership-tier.ts), which demoted exactly one.
  tier        CommunityMembershipTier @default(GROUP)
  /// ══ CENTRAL 25-A §7h — WHO BROUGHT THEM IN, ON THE MEMBERSHIP ITSELF ══════
  ///
  /// Charlie is relying on branch chairs being accountable for the people they
  /// brought in, so the record of who brought in whom must not be destroyable.
  /// It was derivable before this only from `CommunityReferral`, which is
  /// unique per (ROOT community, invitee) — so a branch had no record of its
  /// own, and a person in three branches had one row for all of them.
  ///
  /// ⚠ It survives the inviter's removal: removal archives the membership, and
  /// `CommunityMembershipArchive` carries these two columns across with it.
  /// Nothing anywhere nulls them.
  invitedByUserId   String?
  invitedBy         User?             @relation("MembershipInviter", fields: [invitedByUserId], references: [id])
  /// The invitation they came through, where there was one. Null for somebody
  /// who asked to join of their own accord, and that is a real difference.
  invitedViaInviteId String?
  invitedVia        CommunityInvite?  @relation("MembershipInvite", fields: [invitedViaInviteId], references: [id])
  /// CENTRAL 25-A §7c/§7j — set when the invitation was accepted ON THEIR BEHALF
  /// rather than clicked by them: at first sign-in, or by the sweep over people
  /// who already had an account and an unredeemed invitation.
  /// ⚠ A COLUMN, not an inference from timestamps. "They accepted" and "we
  /// accepted for them" are different facts about consent, and a member who
  /// never clicked anything should be visible as one.
  acceptedOnBehalfAt DateTime?
  /// ══ CENTRAL 25-A §7e — A COMMUNITY TITLE, NOT A PLATFORM ROLE ════════════
  ///
  /// "Branch Chair" is a title inside a Community, defined by that Community,
  /// granting rights only within it. ⚠ `User.role` is the PLATFORM role and is
  /// untouched by any of this: everyone is an ordinary platform member unless
  /// separately granted otherwise, and the two must never share a namespace.
  titleId           String?
  title             CommunityTitle?   @relation(fields: [titleId], references: [id])
  // Bulletin-board "unread" count is derived at read time as posts/replies
  // newer than this per member — bumped whenever the member views the board.
  lastReadAt  DateTime            @default(now())

  // Community membership intentionally grants no Idea access — kept separate so
  // Idea permissions stay tightly scoped, decision 22 Jul 2026. Idea access is
  // governed entirely by IdeaCollaborator/Group; do not join across these tables
  // to derive permissions.
  @@unique([communityId, userId])
}

/// CENTRAL 25-A §7e — a title a Community defines for itself.
///
/// ⚠ NOT A PLATFORM ROLE, and deliberately not near one. `User.role`
/// (CITIZEN / MODERATOR / ADMIN / SUPER_ADMIN) governs the platform; a title
/// governs nothing outside the Community that defined it. A Community may call
/// somebody "Branch Chair", "Regional Organiser" or anything else without that
/// meaning anything at all on the rest of Scrutinise.
///
/// `grantsInvite` is the only right a title carries today. Adding a second is a
/// column here and a branch in `inviteRightFor` — never a platform role.
model CommunityTitle {
  id           String    @id @default(uuid())
  communityId  String
  community    Community @relation(fields: [communityId], references: [id])
  name         String
  description  String?
  grantsInvite Boolean   @default(false)
  members      CommunityMember[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([communityId, name])
}

model CommunityInvite {
  id              String    @id @default(uuid())
  communityId     String
  community       Community @relation(fields: [communityId], references: [id])
  inviteCode      String    @unique
  email           String?
  maxUses         Int       @default(1)
  usedCount       Int       @default(0)
  expiresAt       DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())
  /// CENTRAL 25-A §2a — when the invitation link was first opened, set once by
  /// the invite screen. ⚠ AN HONEST LIMIT, RENDERED ON THE PAGE: a corporate
  /// mail scanner that follows links sets this without a human seeing anything.
  /// "Opened" is evidence the link works, not that the person read it.
  openedAt        DateTime?
  /// CENTRAL 25-A §2d — a revoked invitation is REFUSED at redemption
  /// (app/api/communities/join/route.ts), not merely hidden from a list.
  /// ⚠ Kept separate from `expiresAt`, which was the only way to stop an invite
  /// before this: an invitation called off and one that simply ran out are
  /// different facts and an owner has to be able to tell them apart.
  revokedAt       DateTime?
  revokedByUserId String?
  referrals       CommunityReferral[] @relation("ReferralInvite")
  joinRequests    CommunityJoinRequest[] @relation("JoinRequestInvite")
  memberships     CommunityMember[]      @relation("MembershipInvite")
}

// Branches are invite-only; a Community member who does not belong to a branch
// asks to join it and anyone with manage rights on that node decides
// (Stage 1.2, docs/SCRUTINISE_CENTRAL_SPEC.md §3.2).
//
// `status` is a plain String rather than an enum for the same reason as
// BulletinPost.scope — no CREATE TYPE runs against a live database — and the
// value set is validated by Zod at every write boundary.
//
// ⚠ The duplicate-pending guard is a PARTIAL unique index that Prisma's schema
// language cannot express: `CommunityJoinRequest_pending_unique` on
// (communityId, userId) WHERE status = 'PENDING'. It is created by
// prisma/central_stage1_2.sql and is NOT visible here, so `prisma migrate diff`
// will want to drop it — do not let it. A plain @@unique would be wrong: it
// would make a declined request permanently un-repeatable, and re-requesting
// after a decline is deliberately allowed.
model CommunityJoinRequest {
  id              String    @id @default(uuid())
  communityId     String
  community       Community @relation(fields: [communityId], references: [id])
  /// CENTRAL 25-A 3b - set when this request was raised by ARRIVING THROUGH AN
  /// INVITE LINK rather than by asking from inside the Community. Nobody joins
  /// on click any more: the link puts them here, and somebody with invitation
  /// rights decides. Null on a request somebody made of their own accord.
  inviteId        String?
  invite          CommunityInvite? @relation("JoinRequestInvite", fields: [inviteId], references: [id])
  userId          String
  user            User      @relation("JoinRequester", fields: [userId], references: [id])
  status          String    @default("PENDING")
  message         String?
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?
  decidedByUserId String?
  decidedBy       User?     @relation("JoinDecider", fields: [decidedByUserId], references: [id])

  @@index([communityId, status])
  @@index([userId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// CENTRAL Stage 2 — points & leaderboards.
//
// AN EVENT LEDGER, NOT BALANCES. Every earning and deduction is one signed,
// timestamped, source-tagged row; balances and leaderboards are COMPUTED from
// it and never stored. Three things fall out of that choice:
//   · any leaderboard window is just a `createdAt` filter, so the
//     monthly/quarterly/all-time switcher needs no extra storage
//   · a mispriced tariff is correctable going forward without rewriting history
//   · Central points stay arithmetically compatible with, but SEPARATE from,
//     legislation points — nothing here touches Reputation or CredibilityScore,
//     and the two are never summed
// Never add a running total as the source of truth.
//
// Statuses and types are plain Strings for the same reason as
// BulletinPost.scope: no CREATE TYPE against a live database. Zod validates at
// every write boundary. See docs/SCRUTINISE_CENTRAL_SPEC.md §4.
// ─────────────────────────────────────────────────────────────────────────────

model PointsEvent {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation("CentralPointsEarner", fields: [userId], references: [id])
  // The ROOT Community this event belongs to — the scope every balance and
  // leaderboard is computed within.
  communityId String
  community   Community @relation("CentralPointsCommunity", fields: [communityId], references: [id])
  // The NODE the activity actually happened on (the post's branch, the claim's
  // branch). Not in the brief's field list; added because branch leaderboards
  // are otherwise derived from current membership, which double-counts anyone
  // in two branches and silently rewrites history when someone moves.
  sourceCommunityId String?
  sourceCommunity   Community? @relation("CentralPointsSourceCommunity", fields: [sourceCommunityId], references: [id])
  // MARK_RECEIVED | MARK_REMOVED | CLAIM_APPROVED | REFERRAL_BONUS
  type        String
  /// Signed. Deductions and reversals are negative rows; the ledger only appends.
  points      Int
  sourceType  String
  sourceId    String
  /// Who caused this (the marker, the approving admin). Also what the daily
  /// marking budget is counted from — counting live BulletinVote rows would let
  /// someone withdraw a mark to refund their budget.
  actorUserId String?
  actor       User?     @relation("CentralPointsActor", fields: [actorUserId], references: [id])
  /// Tariff snapshot, stamped at event time so that retuning a tariff can never
  /// change what a past event was worth.
  tariffKey    String
  tariffPoints Int
  tariffId     String?
  createdAt   DateTime  @default(now())

  @@index([communityId, createdAt])
  @@index([communityId, userId])
  @@index([sourceCommunityId, createdAt])
  @@index([sourceType, sourceId])
  @@index([actorUserId, createdAt])
}

/// Point values per action, editable by Charlie as rows rather than code.
/// Resolution: the active row for an actionKey with the latest effectiveFrom
/// at or before now. Editing inserts/updates a row; events already written keep
/// their stamped value.
model PointsTariff {
  id            String   @id @default(uuid())
  actionKey     String
  points        Int
  effectiveFrom DateTime @default(now())
  active        Boolean  @default(true)
  note          String?
  createdAt     DateTime @default(now())

  @@index([actionKey, active, effectiveFrom])
}

/// Numeric configuration that is not a point value: referral rates per layer,
/// decay half-life and floor, the reboost threshold, the daily marking budget.
model PointsConfig {
  id            String   @id @default(uuid())
  key           String   @unique
  numericValue  Float
  note          String?
  updatedAt     DateTime @updatedAt
}

/// Who introduced whom, PER COMMUNITY. Distinct from User.referredByUserId,
/// which is the single global chain the main system's Teambuilder cascade uses.
/// Created only by redeeming a specific person's invite — a join request creates
/// no chain, because nobody introduced them.
model CommunityReferral {
  id             String    @id @default(uuid())
  communityId    String
  community      Community @relation(fields: [communityId], references: [id])
  inviterUserId  String
  inviter        User      @relation("CentralReferralInviter", fields: [inviterUserId], references: [id])
  inviteeUserId  String
  invitee        User      @relation("CentralReferralInvitee", fields: [inviteeUserId], references: [id])
  /// CENTRAL 25-A §2b — WHICH invitation this arrival came through, so a link
  /// arrival is a recorded fact and not an inference from "this member matches
  /// no direct invitation".
  /// ⚠ NULL on every row written before 1 Sep 2026. Those are rendered as
  /// "arrived before we recorded which link", never as "arrived through a link".
  inviteId       String?
  invite         CommunityInvite? @relation("ReferralInvite", fields: [inviteId], references: [id])
  /// The decay clock. Starts at the join date and is reset to now by a reboost.
  decayFrom      DateTime  @default(now())
  /// Set once, when this invitee first crosses the reboost threshold.
  boostedAt      DateTime?
  /// CENTRAL Stage 2e — the fraction of a point this link is carrying.
  /// ⚠ WHY IT EXISTS: the chain paid a floored percentage of each event, and
  /// 10% of a 4-point mark floors to zero — so marks paid the chain NOTHING,
  /// and raising the mark value would only have moved the threshold. Each link
  /// now accrues a decimal and mints a whole PointsEvent when it crosses 1.0.
  bonusBalance   Float     @default(0)
  createdAt      DateTime  @default(now())

  @@unique([communityId, inviteeUserId])
  @@index([communityId, inviterUserId])
  @@index([inviteId])
}

/// Offline activity: the member logs it, the tariff pays out AT ONCE, and the
/// award appears in the Community activity log. A manager of that node — or of
/// any node above it — may reverse it afterwards, with a reason.
///
/// ⚠ CHANGED 24 Aug 2026 (Stage 2e). Approval-before-payment is gone. Speed for
/// members, accountability kept through visibility plus reversal: the visible
/// log IS the anti-abuse mechanism, and it works after the fact as well as
/// before it.
///
/// ⚠ The duplicate guard is an EXPRESSION partial unique index Prisma cannot
/// declare: `ActivityClaim_one_per_day` on (userId, activityType,
/// (occurredAt::date)) WHERE status <> 'DECLINED'. Created by
/// prisma/central_stage2.sql — a migrate diff will want to drop it.
model ActivityClaim {
  id              String    @id @default(uuid())
  communityId     String
  community       Community @relation(fields: [communityId], references: [id])
  userId          String
  user            User      @relation("CentralClaimant", fields: [userId], references: [id])
  activityType    String
  occurredAt      DateTime
  evidenceUrl     String?
  note            String?
  /// CENTRAL Stage 2e — AWARDED | REVERSED. Pre-approval was removed on
  /// 24 Aug 2026: a claim pays on submission and a manager may reverse it
  /// afterwards with a reason. PENDING | APPROVED | DECLINED survive only as
  /// historical values; central_stage2e.sql renamed every APPROVED row and
  /// awarded every PENDING one.
  status          String    @default("AWARDED")
  decidedByUserId String?
  decidedBy       User?     @relation("CentralClaimDecider", fields: [decidedByUserId], references: [id])
  decidedAt       DateTime?
  /// Who reversed it, when, and why. A reason is REQUIRED to reverse — an
  /// unaccountable clawback is the thing this whole model has to avoid.
  reversedByUserId String?
  reversedBy      User?     @relation("CentralClaimReverser", fields: [reversedByUserId], references: [id])
  reversedAt      DateTime?
  reversalReason  String?
  createdAt       DateTime  @default(now())

  @@index([communityId, status])
  @@index([userId, activityType])
}

// ─────────────────────────────────────────────────────────────────────────────
// CENTRAL Stage 2b — the question library.
//
// A library of the hard questions members actually get asked, with
// community-rated answers, and a pack builder that turns a filtered slice into
// a field aid. docs/SCRUTINISE_CENTRAL_SPEC.md §5.
//
// Three vote-ish things that are deliberately NOT the same mechanism:
//   · QuestionVote  — up only. Means "I get asked this too": it records
//     FREQUENCY, not quality, which is why self-voting is allowed (the asker
//     demonstrably was asked) and why there is no downvote.
//   · AnswerVote    — up or down, mutually exclusive, self-voting refused,
//     consistent with the Stage 2 no-marking-own-content rule.
//   · AnswerFavourite — PRIVATE. No count, no ranking effect, never aggregated
//     or exposed anywhere, including admin views.
//
// Enum-ish columns are plain Strings for the same reason as the rest of
// Central: no CREATE TYPE against a live database, Zod at every boundary.
// ─────────────────────────────────────────────────────────────────────────────

model Question {
  id          String    @id @default(uuid())
  /// The ROOT Community. Everything in the library is scoped to one Community.
  communityId String
  community   Community @relation("QuestionCommunity", fields: [communityId], references: [id])
  authorId    String
  author      User      @relation("QuestionAuthor", fields: [authorId], references: [id])
  text        String
  /// COMMUNITY (the default) | BRANCH
  scope       String    @default("COMMUNITY")
  /// The author's branch. Recorded even when scope is COMMUNITY, so "which
  /// branch is asking this" stays answerable for filtering and for the
  /// across-branches view.
  branchId    String?
  branch      Community? @relation("QuestionBranch", fields: [branchId], references: [id])
  /// Where the question gets asked (Doorstep, Media interview, …) and what it
  /// is about (Local finance, Housing, …). Free-form arrays: the topic list is
  /// admin-extendable, so a fixed enum would need a migration per new topic.
  contextTags String[]  @default([])
  topicTags   String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// CENTRAL content soft-delete (27 Aug 2026). See prisma/central_content_delete.sql.
  /// `deletedWithParent` marks content that went down BECAUSE its parent did, so a
  /// restore brings back exactly that and never resurrects something its own author
  /// had already deleted separately.
  deletedAt         DateTime?
  deletedByUserId   String?
  deletedBy         User?     @relation("QuestionDeleter", fields: [deletedByUserId], references: [id])
  deletionReason    String?
  deletedWithParent Boolean   @default(false)

  answers   Answer[]
  votes     QuestionVote[]

  @@index([communityId, createdAt])
  @@index([communityId, scope])
  @@index([branchId])
}

model Answer {
  id           String   @id @default(uuid())
  questionId   String
  question     Question @relation(fields: [questionId], references: [id])
  authorId     String
  author       User     @relation("AnswerAuthor", fields: [authorId], references: [id])
  /// Item 13 — free text, PERMANENT, never hidden by the approval toggle.
  context      String?
  /// Item 13 — who asserted the approval. ALWAYS displayed by name: under mode
  /// (a) the stamp is the poster's own claim, and showing an unverified self-tick
  /// as a bare organisational endorsement would put the organisation's name on
  /// material it has not seen.
  approvedByUserId String?
  approvedBy       User?    @relation("AnswerApprover", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  /// Item 14 — an external video, link only, no hosting.
  videoUrl     String?
  videoTitle   String?
  /// CENTRAL Stage 2e (the Stage 2c launch blocker) — MEMBER | AI.
  /// An AI-authored answer is labelled wherever it appears and mints NO points:
  /// a vote on one still ranks it, and emits no PointsEvent, because otherwise
  /// the seed account accrues points for content nobody wrote.
  authorType   String   @default("MEMBER")
  /// Which model, when authorType is AI. Null for a member's answer.
  aiModel      String?
  body         String
  /// Links backing the answer up. A list, so the UI can render them as sources.
  sources      String[] @default([])
  /// "This worked on my patch" — rendered as its own teal block, deliberately
  /// distinct from sources.
  localExample String?
  /// Managers can hide an answer outright as well as flagging it.
  /// ⚠ HIDDEN IS NOT DELETED. Hidden is moderation — the answer exists, its author
  /// still sees it, and a manager has said "not this one" with a reason. Deleted is
  /// gone. Overloading one for the other would make every query about hidden answers
  /// silently include deleted ones.
  hidden       Boolean  @default(false)
  /// CENTRAL content soft-delete (27 Aug 2026).
  deletedAt         DateTime?
  deletedByUserId   String?
  deletedBy         User?    @relation("AnswerDeleter", fields: [deletedByUserId], references: [id])
  deletionReason    String?
  deletedWithParent Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  votes       AnswerVote[]
  favourites  AnswerFavourite[]
  flags       AnswerFlag[]
  suggestions EditSuggestion[]

  @@index([questionId, hidden])
  @@index([authorId])
}

/// "I've been asked this too." Up only; frequency, not quality.
model QuestionVote {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  userId     String
  user       User     @relation("QuestionVoter", fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([questionId, userId])
  @@index([questionId])
}

model AnswerVote {
  id        String   @id @default(uuid())
  answerId  String
  answer    Answer   @relation(fields: [answerId], references: [id])
  userId    String
  user      User     @relation("AnswerVoter", fields: [userId], references: [id])
  /// UP | DOWN. Mutually exclusive — switching withdraws the previous vote
  /// rather than stacking, so the displayed count moves by 2.
  direction String
  /// Reserved for credibility-weighted voting. Defaulted to 1.0 and APPLIED in
  /// the sort, but NO weighting logic is implemented this sprint — flat votes
  /// for the pilot. The column exists so weighting can be switched on later
  /// without a migration.
  voteWeight Float   @default(1.0)
  createdAt DateTime @default(now())

  @@unique([answerId, userId])
  @@index([answerId])
}

/// PRIVATE. Never counted, never ranked, never shown to anyone but its owner —
/// including admins, and including the across-branches view.
model AnswerFavourite {
  id        String   @id @default(uuid())
  answerId  String
  answer    Answer   @relation(fields: [answerId], references: [id])
  userId    String
  user      User     @relation("AnswerFavouriter", fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([answerId, userId])
  @@index([userId])
}

/// A manager's warning on an answer. DO_NOT_USE excludes it from packs;
/// USE_WITH_CARE stays packable and the reason travels into the output.
model AnswerFlag {
  id          String   @id @default(uuid())
  answerId    String
  answer      Answer   @relation(fields: [answerId], references: [id])
  /// DO_NOT_USE | USE_WITH_CARE
  level       String
  /// Required. A flag without a stated reason is an unaccountable veto.
  reason      String
  setByUserId String
  setBy       User     @relation("AnswerFlagger", fields: [setByUserId], references: [id])
  setAt       DateTime @default(now())

  @@unique([answerId])
  @@index([answerId])
}

/// A reader's proposed rewording. Goes to the ANSWER'S AUTHOR, who applies or
/// dismisses it. There is deliberately no admin path: an edit suggestion is a
/// conversation between two members, not a moderation action.
model EditSuggestion {
  id                String   @id @default(uuid())
  answerId          String
  answer            Answer   @relation(fields: [answerId], references: [id])
  suggestedByUserId String
  suggestedBy       User     @relation("EditSuggester", fields: [suggestedByUserId], references: [id])
  suggestedBody     String
  /// PENDING | APPLIED | DISMISSED
  status            String   @default("PENDING")
  createdAt         DateTime @default(now())
  decidedAt         DateTime?

  @@index([answerId, status])
  @@index([suggestedByUserId])
}

/// A saved slice of the library, built into a field aid.
model Pack {
  id          String    @id @default(uuid())
  ownerId     String
  owner       User      @relation("PackOwner", fields: [ownerId], references: [id])
  communityId String
  community   Community @relation("PackCommunity", fields: [communityId], references: [id])
  name        String
  /// The library filter this pack was built from, stored whole so "Change
  /// filters" round-trips and the pack can be rebuilt as the library moves.
  filter      Json      @default("{}")
  size        Int       @default(10)
  /// Pinned ids hold their position when the ranking moves; removed ids stay
  /// out. Ordered, hence arrays rather than a join table.
  pinnedQuestionIds  String[] @default([])
  removedQuestionIds String[] @default([])
  /// GLANCE | FLASHCARD | LIST | PRINT
  outputFormat String   @default("GLANCE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([communityId, ownerId])
}

/// The admin-extendable topic list, and which tags are promoted to a visible
/// filter chip. Unpromoted tags live in the dropdown, so the chip row stays
/// short as tags multiply.
model QuestionTag {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation("QuestionTagCommunity", fields: [communityId], references: [id])
  /// CONTEXT_EXTERNAL | CONTEXT_INTERNAL | TOPIC
  kind        String
  label       String
  promoted    Boolean   @default(false)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@unique([communityId, kind, label])
  @@index([communityId, kind])
}

// ─── CENTRAL Stage 2d — the training exchange ────────────────────────────────
// docs/SCRUTINISE_CENTRAL_SPEC.md §7. Scoped to ONE Community: `communityId` is
// always the ROOT id, as in the question library. No cross-Community and no
// public listings at this stage.
model TrainingListing {
  id           String    @id @default(uuid())
  communityId  String
  community    Community @relation("TrainingListingCommunity", fields: [communityId], references: [id])
  authorId     String
  author       User      @relation("TrainingListingAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  /// OFFER | REQUEST
  kind         String
  topic        String
  description  String
  /// Free text on purpose — "Tuesday evenings, or a Saturday at a push" is the
  /// real answer and no structured field holds it.
  availability String    @default("")
  /// What the AUTHOR consents to share once BOTH sides have accepted a match.
  shareEmail   Boolean   @default(false)
  sharePhone   Boolean   @default(false)
  /// OPEN | MATCHED | CLOSED
  status       String    @default("OPEN")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  matches  TrainingMatch[]
  sessions TrainingSession[] @relation("TrainingSessionListing")

  @@index([communityId, status])
  @@index([communityId, kind])
  @@index([authorId])
}

/// A proposal on a listing. Several may exist; accepting one sets the listing
/// to MATCHED.
///
/// TWO ACCEPTANCE TIMESTAMPS, NOT ONE. Contact details are revealed only when
/// both are set, so "both sides accepted" is a condition that can be read back
/// from the row rather than inferred from a status string.
/// `responderAcceptedAt` is stamped at creation — the responder is shown
/// exactly what of theirs will be shared, and with whom, before the request is
/// sent. `authorAcceptedAt` is stamped when the listing's author accepts.
///
/// CLOSING IS NOT A STATUS: a closed match must still record that it WAS
/// accepted, so closure is `closedAt`/`closedByUserId` and `status` keeps the
/// brief's PROPOSED | ACCEPTED | DECLINED set.
model TrainingMatch {
  id                  String          @id @default(uuid())
  listingId           String
  listing             TrainingListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  responderId         String
  responder           User            @relation("TrainingResponder", fields: [responderId], references: [id], onDelete: Cascade)
  /// PROPOSED | ACCEPTED | DECLINED
  status              String          @default("PROPOSED")
  message             String?
  /// CENTRAL Stage 2e — the listing author's line when they accept or decline.
  /// ⚠ A silent refusal in a branch of a dozen people is worse than no listing
  /// at all, so the author is offered a sentence on BOTH decisions.
  authorMessage       String?
  /// What the RESPONDER consents to share. Independent of the listing's ticks:
  /// if one side ticked email only, the other sees email only.
  shareEmail          Boolean         @default(false)
  sharePhone          Boolean         @default(false)
  responderAcceptedAt DateTime?
  authorAcceptedAt    DateTime?
  acceptedAt          DateTime?
  closedAt            DateTime?
  closedByUserId      String?
  closedBy            User?           @relation("TrainingMatchCloser", fields: [closedByUserId], references: [id])
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  sessions TrainingSession[] @relation("TrainingSessionMatch")

  @@unique([listingId, responderId])
  @@index([listingId, status])
  @@index([responderId])
}

/// The Stage 2c record. STAGE 2c WAS NEVER BUILT — there is no
/// central_stage2c.sql and no `authorType` anywhere — so this table is created
/// by central_stage2d.sql because "Log this session" cannot exist without it.
/// When 2c is built it must ADD to this table, not recreate it.
///
/// One session, two participants, two ActivityClaims. `matchId` is UNIQUE so
/// logging twice does not raise four claims.
model TrainingSession {
  id             String           @id @default(uuid())
  communityId    String
  community      Community        @relation("TrainingSessionCommunity", fields: [communityId], references: [id])
  matchId        String?          @unique
  match          TrainingMatch?   @relation("TrainingSessionMatch", fields: [matchId], references: [id])
  listingId      String?
  listing        TrainingListing? @relation("TrainingSessionListing", fields: [listingId], references: [id])
  trainerId      String
  trainer        User             @relation("TrainingTrainer", fields: [trainerId], references: [id])
  traineeId      String
  trainee        User             @relation("TrainingTrainee", fields: [traineeId], references: [id])
  topic          String
  occurredAt     DateTime
  notes          String?
  loggedByUserId String
  loggedBy       User             @relation("TrainingSessionLogger", fields: [loggedByUserId], references: [id])
  /// The two claims this session raised. Nullable because a duplicate-per-day
  /// claim is REUSED rather than re-raised, and the reuse is recorded here.
  trainerClaimId String?
  traineeClaimId String?
  createdAt      DateTime         @default(now())

  @@index([communityId, occurredAt])
  @@index([trainerId])
  @@index([traineeId])
}

// Bulletin board — thread + reply share one self-referential table (same
// pattern as RootCause.parentId / DiagnosisCause.parentCauseId): parentId
// null = root post (title/category set); non-null = a reply (title/category
// left null). Scoped to exactly one Community, never a cross-Community feed
// (Stage 1 spec, docs/SCRUTINISE_CENTRAL_SPEC.md §3). Keyword search is plain
// ILIKE over title+body at this scale — deliberately NOT the corpus-search
// stack (different scale, different problem; see §9 "Deferred" semantic-search
// note for the future trigger condition).
model BulletinPost {
  id          String   @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id])
  parentId    String?
  parent      BulletinPost?  @relation("BulletinPostReplies", fields: [parentId], references: [id])
  replies     BulletinPost[] @relation("BulletinPostReplies")
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  // Root posts only — the "Training — offers & requests" category is seeded
  // as one of the default category tags at Community creation time (Stage 1
  // workaround for the Stage 2c structured training marketplace).
  title       String?
  category    String?
  body        String
  // Post reach, chosen in the composer's "Post to" selector (Stage 1.1).
  // 'BRANCH'    — visible only on the board of `communityId` (the default).
  // 'COMMUNITY' — visible on every board in the same Community tree, tagged
  //               "Community-wide". The post still belongs to the node it was
  //               written on, so authorship and membership stay coherent; only
  //               its visibility widens. Replies inherit the thread's node.
  // Plain String, not an enum: no CREATE TYPE needed on a live DB and the
  // value set is validated by Zod at every write boundary.
  scope       String   @default("BRANCH")
  // Cached net (upvotes - downvotes), maintained alongside BulletinVote writes
  // — avoids a COUNT aggregate on every thread-list render.
  score       Int      @default(0)
  /// CENTRAL content soft-delete (27 Aug 2026).
  deletedAt         DateTime?
  deletedByUserId   String?
  deletedBy         User?    @relation("BulletinPostDeleter", fields: [deletedByUserId], references: [id])
  deletionReason    String?
  deletedWithParent Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  votes       BulletinVote[]

  @@index([communityId, parentId])
  @@index([communityId, category])
  @@index([scope, parentId])
}

model BulletinVote {
  id        String   @id @default(uuid())
  postId    String
  post      BulletinPost @relation(fields: [postId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  value     Int      // +1 or -1
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SECTION 6 — REPUTATION & CREDIBILITY
// ─────────────────────────────────────────────────────────────────────────────

model CredibilityScore {
  id                        String    @id @default(uuid())
  userId                    String    @unique
  user                      User      @relation(fields: [userId], references: [id])
  rawScore                  Int       @default(0)
  normalisedScore           Decimal?
  phase                     String    @default("BUILDING") // BUILDING, ESTABLISHED
  thinkerComponent          Decimal?
  strategistComponent       Decimal?
  rallymasterComponent      Decimal?
  rainmakerComponent        Decimal?
  teambuilderComponent      Decimal?
  accountAgeComponent       Decimal?
  peerEndorsementComponent  Decimal?
  totalScore                Decimal?
  lexLogicScore             Decimal?  // Sprint 1
  lastCalculatedAt          DateTime  @default(now())
}

model Reputation {
  id                           String    @id @default(uuid())
  userId                       String    @unique
  user                         User      @relation(fields: [userId], references: [id])
  reputationPointsStrategist   Int       @default(0)
  reputationPointsThinker      Int       @default(0)
  reputationPointsRallymaster  Int       @default(0)
  reputationPointsRainmaker    Int       @default(0)
  reputationPointsTeambuilder  Int       @default(0)
  thanksReceived               Int       @default(0)
  reputationRankScore          Decimal?
  updatedAt                    DateTime  @updatedAt
}

model PointsLedger {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  category         PointsCategory
  pointsDelta      Int
  actionType       String?
  reason           PointsReason
  triggerEntityId  String?
  relatedIdeaId    String?
  relatedIdea      Idea?         @relation(fields: [relatedIdeaId], references: [id])
  relatedUserId    String?
  relatedUser      User?         @relation("PointsRelatedUser", fields: [relatedUserId], references: [id])
  createdAt        DateTime      @default(now())
  reversedAt       DateTime?

  @@index([userId])
  @@index([relatedIdeaId])
}

model ReferralEvent {
  id              String    @id @default(uuid())
  referrerUserId  String
  referrer        User      @relation("ReferrerUser", fields: [referrerUserId], references: [id])
  referredUserId  String
  referred        User      @relation("ReferredUser", fields: [referredUserId], references: [id])
  referralCode    String
  registeredAt    DateTime
  qualifiedAt     DateTime?
  actionCount     Int       @default(0)
  pointsAwarded   Boolean   @default(false)

  @@index([referrerUserId])
  @@index([referredUserId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SECTION 7 — IDEA REVIEW (new in Sprint 1)
// ─────────────────────────────────────────────────────────────────────────────

model IdeaReview {
  id                  String            @id @default(uuid())
  ideaId              String
  idea                Idea              @relation(fields: [ideaId], references: [id])
  userId              String
  user                User              @relation(fields: [userId], references: [id])
  outcome             IdeaReviewOutcome
  qualityRating       Int?              // 1–5 quality score for argument quality
  timeOnPageSeconds   Int?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([ideaId, userId])
  @@index([ideaId])
}

model IdeaAlert {
  id          String    @id @default(cuid())
  userId      String
  ideaId      String
  alertType   AlertType
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  idea        Idea      @relation(fields: [ideaId], references: [id])

  @@unique([userId, ideaId, alertType])
  @@index([ideaId])
  @@index([userId])
}

model GeneratedOutput {
  id            String                @id @default(cuid())
  ideaId        String
  idea          Idea                  @relation(fields: [ideaId], references: [id])
  documentType  GeneratedOutputType
  status        GeneratedOutputStatus @default(PENDING)
  content       String?               // generated text (plain)
  contentHtml   String?               // formatted HTML version
  version       Int                   @default(1)
  generatedAt   DateTime?
  generatedBy   String?               // model identifier used
  wordCount     Int?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([ideaId, documentType])
  @@index([ideaId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SECTION 7B — LEX REBUILD: CANONICAL STATE (see docs/LEX_REBUILD_DESIGN.md)
// ─────────────────────────────────────────────────────────────────────────────

// Per-field state machine (§3.2). Server-authoritative — the single source of
// truth for "where we are". The confirmation card renders iff status is
// AWAITING_CONFIRMATION; Lex and the frontend NEVER write this table.
enum FieldStatus {
  EMPTY
  AWAITING_CONFIRMATION
  ACCEPTED
  SKIPPED
}

// Provenance of a diagnosis cause (design §7.2): user-authored vs seeded from the
// corpus by Lex ("identified in past debates") via the CAUSE_SEEDING search intent.
enum DiagnosisCauseSource {
  USER
  LEX_CORPUS
}

// The Rumelt spine (design §16.1): a cause is either MATERIAL (remove it and the
// problem largely goes away — decisive) or CONTRIBUTORY (worsens it, not decisive).
// UNASSESSED until Lex has pressed the user for the call. The root cause is chosen
// among the MATERIAL causes.
enum CauseClassification {
  MATERIAL
  CONTRIBUTORY
  UNASSESSED
}

// Provenance of a guiding-policy option or a Lex action (design §17/§18): authored
// by the user vs seeded by Lex (per material cause / from the toolkit).
enum LexEntitySource {
  USER
  LEX
}

// Status of a candidate guiding-policy approach (design §17): a menu is driven to a
// single CHOSEN; the rest become RULED_OUT with reasons (the residue of choosing).
enum PolicyOptionStatus {
  CANDIDATE
  CHOSEN
  RULED_OUT
}

// Which piece of Lex's output the user is critiquing (design §20.5).
enum FeedbackSurface {
  BRIEFING
  CAUSES
  OPTIONS
  COSTS
  OTHER
}

// §20.5 — a critique of Lex's output, passed back to Scrutinise WITH CONSENT.
// The user sees `summarisedText` verbatim and answers Yes / Edit / No; nothing is
// stored or sent before that Yes, so every row here is one the user approved.
// `originalText` is what they actually said; `summarisedText` is what leaves their
// control — personal content stripped, and it is the ONLY text that is emailed.
model FeedbackItem {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ideaId          String
  idea            Idea            @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  stage           String          // the Lex page the critique was made on, e.g. "ORIENTATION"
  surface         FeedbackSurface @default(OTHER)
  originalText    String          @db.Text
  summarisedText  String          @db.Text
  userEdited      Boolean         @default(false) // true when they took the Edit path
  consentGiven    Boolean         @default(true)  // always true on write; explicit, never implied
  // Persist-then-send (§20.5): a mail failure must not lose the record. Null until
  // a send is attempted; set to the failure on error so it is visible, not lost.
  sentAt          DateTime?
  sendError       String?
  createdAt       DateTime        @default(now())

  @@index([ideaId])
  @@index([userId])
  @@index([createdAt])
}

model IdeaFieldState {
  id        String      @id @default(uuid())
  ideaId    String
  idea      Idea        @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  fieldKey  String      // canonical field key, e.g. "ideaNarrative", "title", "keywords"
  status    FieldStatus @default(EMPTY)
  value     String?     // accepted value (plain text, or JSON-encoded for structured fields)
  proposal  Json?       // { value, rationale } — present only while AWAITING_CONFIRMATION
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([ideaId, fieldKey])
  @@index([ideaId])
}

// The "Initial Background" briefing (§8.2): a generated document on the idea,
// rendered in the legislation panel and (later) the Documents/Exports tab.
model Document {
  id        String   @id @default(uuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  kind      String   // "INITIAL_BACKGROUND"
  status    String   @default("pending") // pending | ready
  summary   String?  // short preview text surfaced in the canonical state object
  body      String?  // full prose briefing (stub for now; Word/PDF render later)
  // Sprint 2.5 (§8.2) — the export pair. `docxUrl`/`pdfUrl` hold the APP download
  // path (stable, authorised, redirects to a fresh 24h signed URL); `docxKey`/
  // `pdfKey` hold the R2 object key. A signed URL expires, so it is never stored.
  docxUrl   String?
  pdfUrl    String?
  docxKey   String?
  pdfKey    String?
  // Provenance of the generated pair. `sourceFingerprint` is a sha-256 over the
  // exact stored state that was rendered; when the live state hashes differently
  // the file is STALE and the UI says so rather than serving it silently.
  generatedAt       DateTime?
  sourceFingerprint String?
  sourceLabel       String?   // human "generated from …", shown next to the download
  exportError       String?   // last render/upload failure, surfaced honestly
  /// Sprint 20-B (§20.6) — which STORED VERSION this file was rendered from, null
  /// when it was rendered from the live working state. A file made from the draft
  /// and a file made from published v3 look identical on disk, and telling them
  /// apart is the difference between "your draft" and "what the recipient holds".
  proposalVersionId String?
  proposalVersion   ProposalVersion? @relation(fields: [proposalVersionId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ideaId, kind])
  @@index([ideaId])
}

/// ─────────────────────────────────────────────────────────────────────────────
/// Sprint 20-D (§2) — an append-only published version of a proposal.
///
/// ⚠ `snapshot` is the WHOLE §1 assembler output, serialised. A version is NOT a
/// pointer at live state: state moves, and a recipient's link must not move with
/// it. Storing the snapshot is what makes "the version that was shared" a fact
/// rather than a reconstruction from rows that have since changed.
///
/// ⚠ APPEND-ONLY. There is no update path in the application; a change makes the
/// next version. The unique (ideaId, versionNumber) below means a second write of
/// the same number FAILS rather than overwriting, and `check:20bd` asserts the
/// invariant against the live database rather than trusting the intention.
///
/// DDL of record is `prisma/lex_proposal_20bd.sql`. This model exists so that
/// `prisma migrate diff` does not see a table it doesn't know about and propose
/// dropping it — the same pattern as LlmSpend and the position-graph tables.
/// ─────────────────────────────────────────────────────────────────────────────
model ProposalVersion {
  id            String   @id @default(uuid())
  ideaId        String
  idea          Idea     @relation("IdeaProposalVersions", fields: [ideaId], references: [id], onDelete: Cascade)
  versionNumber Int
  /// sha-256 over the snapshot with its volatile fields removed, so an unchanged
  /// proposal does not mint a new version. ⚠ Compared against the LATEST version
  /// only — reverting an edit legitimately reproduces an older hash, and that
  /// must still be recordable.
  contentHash   String
  snapshot      Json
  createdAt     DateTime @default(now())
  createdBy     String
  creator       User     @relation("ProposalVersionCreator", fields: [createdBy], references: [id])
  /// What changed since the previous version, so §24's "12 of 14 findings resolved
  /// since" can be COMPUTED rather than asserted.
  changeNote    String?

  publishedOn   Idea[]     @relation("IdeaPublishedVersion")
  documents     Document[]

  @@unique([ideaId, versionNumber])
  @@index([ideaId, createdAt(sort: Desc)])
  @@index([contentHash])
}

/// §20.3 — the four publication states of a PROPOSAL. See the SQL file for why
/// this is not an extension of `IdeaVisibility`.
enum ProposalVisibility {
  PRIVATE
  LINK
  COMMUNITY
  PUBLIC
}

// Page 2 (Diagnosis) causes loop (design §7.2). Mirrors the CoherentActions
// per-row child pattern. Exactly one row per idea should carry isRootCause = true.
model DiagnosisCause {
  id             String               @id @default(uuid())
  ideaId         String
  idea           Idea                 @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  cause          String               // the cause statement
  whyPersisted   String?              // why it has resisted solution
  evidence       String?              // summary line (upgrades to a richer Evidence record later)
  isRootCause    Boolean              @default(false)
  classification CauseClassification  @default(UNASSESSED) // §16.1 material vs contributory
  // §16.2 causal tree: a self-referencing parent pointer. Root-level causes have
  // parentCauseId = null; a sub-cause points at its parent (soft depth cap 4).
  parentCauseId  String?
  parent         DiagnosisCause?      @relation("CauseTree", fields: [parentCauseId], references: [id], onDelete: Cascade)
  children       DiagnosisCause[]     @relation("CauseTree")
  source         DiagnosisCauseSource @default(USER)

  /// ══ 25-S §2a — THE STABLE NUMBER, EXACTLY AS `PolicyOption` HAS ONE ══════════════
  ///
  /// ⚠⚠ IT IS NOT `orderIndex`, AND THAT IS THE WHOLE POINT. `orderIndex` is the display
  /// position and MOVES when the list is reordered (§2b). The number never moves: a removed 3
  /// leaves a gap, nesting does not renumber, and reordering does not renumber.
  ///
  /// ⚠ WHY IT MATTERS, in Charlie's words: he refers to causes by number when instructing Lex,
  /// and "a number that moves when the list moves turns 'cause 3 is wrong' into an instruction
  /// about a different cause." The same argument 25-P made for policies, and the same failure
  /// mode — a silent mis-instruction that looks like it worked.
  ///
  /// ⚠ NULLABLE for rows written before 25-S; they are numbered by the backfill, oldest first.
  number         Int?
  orderIndex     Int                  @default(0) // display position — MOVES; see `number`
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([ideaId])
  @@index([parentCauseId])
  /// §2a — looked up on every instruction the user types by number.
  @@index([ideaId, number])
}

// Page 3 (Guiding Policy) candidate approach (design §17). Lex seeds candidates per
// material cause (toolkit: incentives, rules, transparency, market design, …), argues
// each for and against; the user reacts, adds, edits, then commits to ONE.
model PolicyOption {
  id             String             @id @default(uuid())
  ideaId         String
  idea           Idea               @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  approach       String             // the candidate approach, one line
  mechanismTypes String[]           @default([]) // incentives | rules | transparency | market-design | institutional
  targetCauseIds String[]           @default([]) // DiagnosisCause ids this approach targets (structural link)
  caseFor        String?            // genuine argument for
  caseAgainst    String?            // genuine argument against
  status         PolicyOptionStatus @default(CANDIDATE)
  /// Why it was ruled out. ⚠ 25-P §1.10 — RETAINED ON RESTORE, so "we rejected this once, for
  /// this reason, and changed our minds" survives as history.
  ruleOutReason  String?
  source         LexEntitySource    @default(USER)
  orderIndex     Int                @default(0)

  // ══════════════ 25-P §1 — THE GUIDING POLICY BECOMES A DECISION ══════════════

  /// ⚠⚠ §1.1 — THE STABLE NUMBER THE USER TYPES. 1..n, assigned once, and it NEVER MOVES.
  /// A rejected 7 leaves a gap; nothing renumbers; a restore returns the original number.
  /// Not tidiness: Charlie instructs Lex BY NUMBER ("merge 4 and 8"), and a renumbering between
  /// his reading the screen and his typing would silently merge two different policies.
  /// ⚠ Nullable because every row predating 25-P has none; they are numbered on first read, in
  /// `createdAt` order, and stable from that moment.
  number         Int?
  /// §1.2 — GUIDING_POLICY | COHERENT_ACTION | GOAL_RESTATEMENT.
  kind           String             @default("GUIDING_POLICY")
  /// ⚠ §1.2 — WHY, IN LEX'S WORDS. A reclassification with no reason is a disappearance.
  kindReason     String?
  sortedAt       DateTime?

  /// ⚠⚠ §1.3 — AN ITEM THAT IS REALLY AN ACTION MOVES ONLY ON CONSENT. OFFERED|ACCEPTED|DECLINED.
  moveStatus     String?
  /// ⚠ §1.3 — THE POLICY THIS ACTION IMPLEMENTS. An action belongs to a POLICY, not to the
  /// kernel in general: if that policy is rejected the action goes with it, rather than sitting
  /// in the kernel implementing something the user threw away an hour ago.
  parkedWithId   String?
  movedToActionId String?

  /// §1.7 — the numbers this was merged from. Empty on an original.
  mergedFrom     Int[]              @default([])
  /// Set on a policy superseded by a merge. ⚠ NOT deleted — the user must be able to see what a
  /// merged policy was made of, and its number must stay taken.
  mergedIntoId   String?

  /// ⚠⚠ §1.6 — TWO JUDGEMENTS, NEVER COMBINED INTO A SCORE. Each carries the one thing that
  /// decides whether a reviewer can trust it: `basis` is REASONED | RETRIEVED | NOT_FOUND.
  /// Shape: { verdict, why, basis }.
  importance     Json?
  addressability Json?

  /// ⚠ §1.8 — WHAT HAPPENS IF ONLY PART IS DELIVERED. A legislature takes the easy half of a
  /// proposal; this is the warning, and it must survive into both generated documents.
  chainLink      String?

  /// §1.10 — NOW or LATER. A policy wanted but not yet is not a rejection.
  phase          String?
  phaseReason    String?

  /// ⚠⚠ §1.4 — WHERE A POLICY ANSWERS A CAUSE THE DIAGNOSIS HAS NOT GOT, either the policy does
  /// not belong or THE DIAGNOSIS IS INCOMPLETE — and the second is far more often true.
  /// Shape: { cause, why, status: OFFERED|ACCEPTED|DECLINED, addedCauseId, declinedReason }.
  /// ⚠ A DECLINE IS RECORDED rather than forgotten: it is a real weakness and the adversarial
  /// read must be able to see it.
  impliedCause   Json?

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([ideaId])
  /// §1.1 — looked up on every instruction the user types.
  @@index([ideaId, number])
}

// Page 4 (Coherent Actions) action record (design §18.1). Kept as a NEW table,
// deliberately isolated from the large legacy `CoherentAction` model (which is wired
// into the old Stage-2 UI and many relations) so the Lex rebuild stays self-contained.
// The §18.2 costs are stored as ranges-with-basis JSON: { low, high, unit, basis,
// benchmarkId?, userOverride? }.
model LexCoherentAction {
  id                 String          @id @default(uuid())
  ideaId             String
  idea               Idea            @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  practicalStep      String          // the action, one line
  mechanismType      String?         // incentives | rules | transparency | market-design | institutional
  whoImplements      String?
  targetOrganisation String?         // legislative actions
  wording            String?         // legislative actions — capture intent now (precise drafting later)
  benefits           Json?           // { financial, social, ongoing } — ranges + basis
  implementationCost Json?           // { low, high, unit, basis, benchmarkId?, userOverride? } — falls on Government
  enforcementCost    Json?           // ongoing cost to police/administer — Regulator/state
  regulatoryFriction Json?           // ongoing compliance burden — the economy
  source             LexEntitySource @default(USER)
  orderIndex         Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  costLines          CostLine[]

  @@index([ideaId])
}

/// Sprint 3-C (§19-C Task 6) — cost engine v0. One costed line at a time under an
/// action ("2 mid-level FTE for 6 months", "a venue hire"), instead of the un-called
/// three-range estimator. Lines roll up per action → the three §18.2 categories →
/// costSummary, uprated to a common price year. Staffing lines suggest a unit cost
/// from the seeded ASHE wage benchmarks — a suggestion the user can always override.
model CostLine {
  id             String            @id @default(uuid())
  actionId       String
  action         LexCoherentAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  label          String
  costType       CostLineType      @default(OTHER)
  category       CostLineCategory  @default(IMPLEMENTATION)
  staffLevel     StaffLevel?       // STAFF lines only
  fteCount       Float?
  durationMonths Float?
  low            Float?
  high           Float?
  unit           String?           // e.g. 'GBP'
  basis          String?           // the stated assumption — required in spirit, never auto-asserted
  benchmarkId    String?           // CostBenchmark the figure came from, when it did
  priceYear      Int?
  orderIndex     Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([actionId])
}

enum CostLineType {
  STAFF
  CAPITAL
  PROPERTY
  RESEARCH
  OTHER
}

enum CostLineCategory {
  IMPLEMENTATION
  ENFORCEMENT
  FRICTION
}

enum StaffLevel {
  JUNIOR
  MID
  SENIOR
}

// The costing engine (design §18.3). CostBenchmark = the shared, sourced default
// values (Green Book, QALY, value of a prevented fatality, admin-burden unit costs …).
// Populated by the Phase-2 research programme; hand-seeded placeholders for now.
// Green Book category (COSTING_SCOPE §3) — the government's own valuation families.
enum BenchmarkCategory {
  HEALTH
  LIFE_SAFETY
  WELLBEING
  TIME
  CRIME
  ADMIN_BURDEN
  EMPLOYMENT_ECONOMY
  HOUSING
  EDUCATION
  ENVIRONMENT
  SERVICE_UNIT_COST
}

// How a benchmark value is uprated to a common price year (COSTING_SCOPE §3).
// VPF uprates by GDP per head; most values by the GDP deflator.
enum UprateMethod {
  GDP_DEFLATOR
  GDP_PER_HEAD
  NONE
}

// Provenance/currency of a benchmark (COSTING_SCOPE §3).
enum BenchmarkConfidence {
  OFFICIAL_CURRENT
  OFFICIAL_DATED
  ACADEMIC
  SECTOR
}

model CostBenchmark {
  id        String   @id @default(uuid())
  domain    String   // e.g. "health", "transport", "admin-burden"
  metric    String   // e.g. "QALY", "value of a prevented fatality"
  unit      String   // e.g. "£/QALY", "£/fatality", "£/hour"
  low       Decimal?
  high      Decimal?
  source    String   // e.g. "HM Treasury Green Book"
  sourceUrl String?
  year      Int?     // publication year of the source
  method    String?  // provenance/notes on how the value was derived
  notes     String?
  // COSTING_SCOPE §3 deltas — so figures can be uprated to a common price base and graded.
  priceYear    Int?                 // the prices the value is expressed in (distinct from `year`)
  category     BenchmarkCategory?
  region       String?              @default("UK") // many unit costs are England-only
  uprateMethod UprateMethod?        @default(GDP_DEFLATOR)
  confidence   BenchmarkConfidence?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([domain])
  @@index([category])
}

// The GDP deflator series as DATA (COSTING_SCOPE §3/§7d), so uprating a £ figure from
// one year's prices to another's is a lookup, not a hardcode. Populated in Phase 2;
// a small illustrative placeholder set ships with the shell.
model DeflatorSeries {
  year      Int      @id
  index     Float    // GDP deflator index (rebased arbitrarily; only ratios matter)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A user's override of a benchmark for THIS idea, with their own evidence (design
// §18.3). Kept alongside the defaults so the briefing shows which numbers are
// defaults, which are overridden, and every source link (the transparent project space).
model IdeaAssumption {
  id           String   @id @default(uuid())
  ideaId       String
  idea         Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  benchmarkId  String?  // the CostBenchmark this overrides (nullable = a fresh assumption)
  userValue    String?  // the user's chosen value/range
  userEvidence String?  // their evidence for it
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ideaId])
}

