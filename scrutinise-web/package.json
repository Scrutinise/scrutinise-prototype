{
  "name": "scrutinise-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:seed": "tsx prisma/seed.ts",
    "check:sprint2.5-schema": "tsx --env-file=.env scripts/check-sprint2_5-schema.ts",
    "check:documents": "tsx scripts/check-document-render.ts",
    "check:feedback": "tsx --env-file=.env scripts/check-feedback-capture.ts",
    "check:export": "tsx --env-file=.env scripts/check-export-e2e.ts",
    "check:central": "tsx --env-file=.env scripts/check-central-stage1.ts",
    "check:orientation": "tsx --env-file=.env scripts/check-orientation.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "npm run db:seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.0",
    "@aws-sdk/client-s3": "^3.1036.0",
    "@aws-sdk/s3-request-presigner": "3.1036.0",
    "@clerk/clerk-react": "^5.59.2",
    "@clerk/nextjs": "^6.36.5",
    "@clerk/shared": "^3.41.1",
    "@google/generative-ai": "^0.24.1",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/nextjs": "^10.46.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.5.1",
    "lucide-react": "^0.553.0",
    "mammoth": "1.12.0",
    "next": "^16.1.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "prisma": "^7.5.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "svix": "^1.89.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.3",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.60.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
