				</ukm:Metadata><Primary><Body DocumentURI="http://www.legislation.gov.uk/ukpga/2010/15/body/enacted" IdURI="http://www.legislation.gov.uk/id/ukpga/2010/15/body" NumberOfProvisions="219" NumberFormat="default"><Part DocumentURI="http://www.legislation.gov.uk/ukpga/2010/15/part/2/enacted" IdURI="http://www.legislation.gov.uk/id/ukpga/2010/15/part/2" NumberOfProvisions="24" id="part-2"><Number>Part 2</Number><Title>Equality: key concepts</Title><Chapter DocumentURI="http://www.legislation.gov.uk/ukpga/2010/15/part/2/chapter/1/enacted" IdURI="http://www.legislation.gov.uk/id/ukpga/2010/15/part/2/chapter/1" NumberOfProvisions="9" id="part-2-chapter-1"><Number>Chapter 1</Number><Title>Protected characteristics</Title><P1group><Title>Sex</Title><P1 DocumentURI="http://www.legislation.gov.uk/ukpga/2010/15/section/11/enacted" IdURI="http://www.legislation.gov.uk/id/ukpga/2010/15/section/11" id="section-11">
<Pnumber>11</Pnumber>
<P1para>
<Text>In relation to the protected characteristic of sex—</Text>
<P3 DocumentURI="http://www.legislation.gov.uk/ukpga/2010/15/section/11/a/enacted" IdURI="http://www.legislation.gov.uk/id/ukpga/2010/15/section/11/a" id="section-11-a">
<Pnumber>a</Pnumber>
<P3para>
<Text>a reference to a person who has a particular protected characteristic is a reference to a man or to a woman;</Text>
</P3para>
</P3>
<P3 DocumentURI="http://www.legislation.gov.uk/ukpga/2010/15/section/11/b/enacted" IdURI="http://www.legislation.gov.uk/id/ukpga/2010/15/section/11/b" id="section-11-b">
<Pnumber>b</Pnumber>
<P3para>
<Text>a reference to persons who share a protected characteristic is a reference to persons of the same sex.</Text>
</P3para>
</P3>
</P1para>
</P1></P1group></Chapter></Part></Body></Primary></Legislation>