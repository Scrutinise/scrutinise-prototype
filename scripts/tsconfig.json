{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "skipLibCheck": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": false,
    "baseUrl": "../scrutinise-web",
    "paths": {
      "dotenv": ["./node_modules/dotenv"],
      "@prisma/client": ["./node_modules/@prisma/client"],
      "@aws-sdk/client-s3": ["./node_modules/@aws-sdk/client-s3"],
      "@aws-sdk/client-s3/*": ["./node_modules/@aws-sdk/client-s3/*"],
      "@anthropic-ai/sdk": ["./node_modules/@anthropic-ai/sdk"],
      "@anthropic-ai/sdk/*": ["./node_modules/@anthropic-ai/sdk/*"],
      "playwright": ["./node_modules/playwright"],
      "playwright/*": ["./node_modules/playwright/*"],
      "pg": ["./node_modules/pg"],
      "pg/*": ["./node_modules/pg/*"],
      "@prisma/adapter-pg": ["./node_modules/@prisma/adapter-pg"],
      "@prisma/adapter-pg/*": ["./node_modules/@prisma/adapter-pg/*"]
    }
  },
  "exclude": ["attic", "**/node_modules", "legislation/v3opt"]
}
