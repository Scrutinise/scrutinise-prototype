{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": false,
    "baseUrl": "../scrutinise-web",
    "paths": {
      "dotenv": ["./node_modules/dotenv"],
      "@prisma/client": ["./node_modules/@prisma/client"],
      "@aws-sdk/client-s3": ["./node_modules/@aws-sdk/client-s3"],
      "@aws-sdk/client-s3/*": ["./node_modules/@aws-sdk/client-s3/*"],
      "@anthropic-ai/sdk": ["./node_modules/@anthropic-ai/sdk"],
      "@anthropic-ai/sdk/*": ["./node_modules/@anthropic-ai/sdk/*"],
      "pg": ["./node_modules/pg"],
      "pg/*": ["./node_modules/pg/*"]
    }
  }
}
