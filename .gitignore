scripts/ingest/.vector-ab/

# V36 source walk artefacts — legislation.gov.uk's published id set, ~30MB and
# regenerable: `v36-source-census.ts --enumerate` is checkpointed per (type, year)
# and resumes, and `v36-reconcile.ts` rebuilds the work list from it. The SUMMARY
# that the findings rest on is committed as docs/v36_reconciliation.json.
scripts/ingest/v36/source-entries.json
scripts/ingest/v36/worklist.jsonl
scripts/ingest/v36/enumerate.log

